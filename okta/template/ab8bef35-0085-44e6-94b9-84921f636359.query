tag=$OKTA_SYSTEM
$OKTA_ALERT_EVX
| lookup -r okta_eventTypes eventType eventType (category subcategory)
| grep -e category "%%okta_category%%"
| eval
    if (!has("actorName") || actorName == "") { actorName = actorAltId; }
    if (!has("targetType") || targetType == "") { targetName = "(no target)"; targetAltId = ""; targetType = ""; }
    else if (!has("targetName") || targetName == "") { targetName = targetAltId; }
| printf -e actor "%v (%v)" actorName actorType
| printf -e target "%v (%v)" targetName targetType
| eval if (targetType == "") { target = "(no target)"; }
| stats count by actor target
| chart count by actor target
