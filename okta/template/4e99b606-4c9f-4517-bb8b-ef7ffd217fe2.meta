{
	"UUID": "4e99b606-4c9f-4517-bb8b-ef7ffd217fe2",
	"Name": "Template - Okta - Investigation - MFA and Recovery Activity for Actor, Target, and/or IP [table]",
	"Description": "MFA and account recovery activity matching the actor, target, and source address you enter: factor enrolments and resets, push notifications, password resets, and unlock messages. This is the sequence to read when you suspect an account takeover, because almost every Okta takeover passes through one of these.\n\nAll three variables accept wildcards, and * matches everything.\n\nRenders as a table in time order.\n\nReference(s):\n- https://developer.okta.com/docs/reference/api/event-types/\n- https://developer.okta.com/docs/api/openapi/okta-management/management/tag/SystemLog/",
	"Data": {
		"variables": [
			{
				"name": "%%1%%",
				"label": "Okta Actor",
				"description": "The account that performed the action, matched against actor.alternateId and actor.displayName.  Wildcards allowed; leave as * for any actor.",
				"required": true,
				"defaultValue": "*",
				"previewValue": "*"
			},
			{
				"name": "%%2%%",
				"label": "Okta Target",
				"description": "The account or object the action was performed against, matched against target.alternateId and target.displayName.  Wildcards allowed; leave as * for any target.",
				"required": true,
				"defaultValue": "*",
				"previewValue": "*"
			},
			{
				"name": "%%3%%",
				"label": "Okta IP",
				"description": "The source address, matched against client.ipAddress and the first hop of request.ipChain.  Wildcards allowed; leave as * for any address.",
				"required": true,
				"defaultValue": "*",
				"previewValue": "*"
			}
		]
	},
	"Labels": [
		"okta"
	]
}