{
	"UUID": "9fc8f842-0a0f-47cb-ae65-f62d61ddc564",
	"Name": "Template - Okta - System - Event Types - Actor and Target [table]",
	"Description": "Shows who did what to whom inside the category you pick: the actor, the object acted upon, and the event type.\n\nRenders as a table.\n\nReference(s):\n- https://developer.okta.com/docs/reference/api/event-types/\n- https://developer.okta.com/docs/api/openapi/okta-management/management/tag/SystemLog/",
	"Data": {
		"variables": [
			{
				"name": "%%okta_category%%",
				"label": "Log Category",
				"description": "The okta_eventTypes category to break down.  Options: Access, Access Control, Application, Audit, Certification, Device, Directory, Group, Hooks, IAM, Integration, Lifecycle, Mim, OAuth2, PAM, PKI, Policy, Security, Support, System, User, Workflows.  Leave as * for every category.",
				"required": true,
				"defaultValue": "*",
				"previewValue": "*"
			}
		]
	},
	"Labels": [
		"okta"
	]
}