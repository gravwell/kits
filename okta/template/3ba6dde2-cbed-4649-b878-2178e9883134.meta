{
	"UUID": "3ba6dde2-cbed-4649-b878-2178e9883134",
	"Name": "Template - Okta - Investigation - Configuration Changes for Actor, Target, and/or IP [table]",
	"Description": "Okta configuration changes matching the actor, target, and source address you enter, scored and prioritised. Only events the okta_eventTypes lookup marks as modifications are kept, so this is the \"what did they change\" view: policies, applications, groups, API tokens, identity providers.\n\nAll three variables accept wildcards, and * matches everything.\n\nRenders as a table sorted by risk score, highest first.\n\nReference(s):\n- https://developer.okta.com/docs/reference/api/event-types/\n- https://developer.okta.com/docs/api/openapi/okta-management/management/tag/SystemLog/",
	"Data": {
		"variables": [
			{
				"name": "%%1%%",
				"label": "Okta Actor",
				"description": "The account that performed the action, matched against actor.alternateId and actor.displayName.  Wildcards allowed; leave as * for any actor.",
				"required": true,
				"defaultValue": "*",
				"previewValue": "*"
			},
			{
				"name": "%%2%%",
				"label": "Okta Target",
				"description": "The account or object the action was performed against, matched against target.alternateId and target.displayName.  Wildcards allowed; leave as * for any target.",
				"required": true,
				"defaultValue": "*",
				"previewValue": "*"
			},
			{
				"name": "%%3%%",
				"label": "Okta IP",
				"description": "The source address, matched against client.ipAddress and the first hop of request.ipChain.  Wildcards allowed; leave as * for any address.",
				"required": true,
				"defaultValue": "*",
				"previewValue": "*"
			}
		]
	},
	"Labels": [
		"okta"
	]
}