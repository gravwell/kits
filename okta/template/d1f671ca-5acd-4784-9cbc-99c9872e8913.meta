{
	"UUID": "d1f671ca-5acd-4784-9cbc-99c9872e8913",
	"Name": "Template - Okta - Investigation - Okta Alerts for Actor, Target, and/or IP [table]",
	"Description": "Alerts the Okta kit raised (tag _alerts, filtered to Contents._vendor Okta) involving an actor, target and/or IP. Variables are wildcard patterns:\n  - Okta Actor: matched anywhere in the alert context (which starts with the actor's login)\n  - Okta Target: the alert's primary target (user acted on, app account or app)\n  - Okta IP: the alert's source IP\n\nThe query reports an unknown tag until the first Okta alert has fired.",
	"Data": {
		"variables": [
			{
				"name": "%%1%%",
				"label": "Okta Actor",
				"description": "This is the user (actorAltId or actorName) who performed the action.",
				"required": true,
				"defaultValue": "*",
				"previewValue": "*"
			},
			{
				"name": "%%2%%",
				"label": "Okta Target",
				"description": "This is the user (targetAltId or targetName) whom the action was performed against.",
				"required": true,
				"defaultValue": "*",
				"previewValue": "*"
			},
			{
				"name": "%%3%%",
				"label": "Okta IP",
				"description": "This is either the clientIp or the requestIp from which the action was performed.",
				"required": true,
				"defaultValue": "*",
				"previewValue": "*"
			}
		]
	},
	"Labels": [
		"okta"
	]
}