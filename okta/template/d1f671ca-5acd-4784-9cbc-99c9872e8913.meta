{
	"UUID": "d1f671ca-5acd-4784-9cbc-99c9872e8913",
	"Name": "Template - Okta - Investigation - Risk Summary by Priority for Actor, Target, and/or IP [table]",
	"Description": "Counts events matching the actor, target, and source address you enter by priority bucket, with the highest risk score reached in each. Use it as the first tile of an investigation: it tells you whether there is anything worth reading before you open the full timeline.\n\nAll three variables accept wildcards, and * matches everything.\n\nRenders as a table.\n\nReference(s):\n- https://developer.okta.com/docs/reference/api/event-types/\n- https://developer.okta.com/docs/api/openapi/okta-management/management/tag/SystemLog/",
	"Data": {
		"variables": [
			{
				"name": "%%1%%",
				"label": "Okta Actor",
				"description": "The account that performed the action, matched against actor.alternateId and actor.displayName.  Wildcards allowed; leave as * for any actor.",
				"required": true,
				"defaultValue": "*",
				"previewValue": "*"
			},
			{
				"name": "%%2%%",
				"label": "Okta Target",
				"description": "The account or object the action was performed against, matched against target.alternateId and target.displayName.  Wildcards allowed; leave as * for any target.",
				"required": true,
				"defaultValue": "*",
				"previewValue": "*"
			},
			{
				"name": "%%3%%",
				"label": "Okta IP",
				"description": "The source address, matched against client.ipAddress and the first hop of request.ipChain.  Wildcards allowed; leave as * for any address.",
				"required": true,
				"defaultValue": "*",
				"previewValue": "*"
			}
		]
	},
	"Labels": [
		"okta"
	]
}