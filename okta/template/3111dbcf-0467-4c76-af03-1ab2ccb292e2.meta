{
	"UUID": "3111dbcf-0467-4c76-af03-1ab2ccb292e2",
	"Name": "Template - Okta - System - Event Types - Event Type [chart]",
	"Description": "Lists every event type seen inside the category you pick, with its volume.\n\nRenders as a chart.\n\nReference(s):\n- https://developer.okta.com/docs/reference/api/event-types/\n- https://developer.okta.com/docs/api/openapi/okta-management/management/tag/SystemLog/",
	"Data": {
		"variables": [
			{
				"name": "%%okta_category%%",
				"label": "Log Category",
				"description": "The okta_eventTypes category to break down.  Options: Access, Access Control, Application, Audit, Certification, Device, Directory, Group, Hooks, IAM, Integration, Lifecycle, Mim, OAuth2, PAM, PKI, Policy, Security, Support, System, User, Workflows.  Leave as * for every category.",
				"required": true,
				"defaultValue": "*",
				"previewValue": "*"
			}
		]
	},
	"Labels": [
		"okta"
	]
}