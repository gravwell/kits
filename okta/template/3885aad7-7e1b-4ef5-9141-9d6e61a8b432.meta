{
	"UUID": "3885aad7-7e1b-4ef5-9141-9d6e61a8b432",
	"Name": "Template - Okta - System - Event Types - Category and Subcategory [table]",
	"Description": "Breaks System Log volume down by subcategory inside the category you pick.\n\nRenders as a table.\n\nReference(s):\n- https://developer.okta.com/docs/reference/api/event-types/\n- https://developer.okta.com/docs/api/openapi/okta-management/management/tag/SystemLog/",
	"Data": {
		"variables": [
			{
				"name": "%%okta_category%%",
				"label": "Log Category",
				"description": "The okta_eventTypes category to break down.  Options: Access, Access Control, Application, Audit, Certification, Device, Directory, Group, Hooks, IAM, Integration, Lifecycle, Mim, OAuth2, PAM, PKI, Policy, Security, Support, System, User, Workflows.  Leave as * for every category.",
				"required": true,
				"defaultValue": "*",
				"previewValue": "*"
			}
		]
	},
	"Labels": [
		"okta"
	]
}