{
	"UUID": "1a2dce93-9c88-43d0-b920-f8fd46ca1e5f",
	"Name": "Template - Okta - System - Event Types - Event Type by Outcome [table]",
	"Description": "Lists every event type seen inside the category you pick, split by Okta outcome result. An event type whose failures dominate is either misconfigured or under attack.\n\nRenders as a table.\n\nReference(s):\n- https://developer.okta.com/docs/reference/api/event-types/\n- https://developer.okta.com/docs/api/openapi/okta-management/management/tag/SystemLog/",
	"Data": {
		"variables": [
			{
				"name": "%%okta_category%%",
				"label": "Log Category",
				"description": "The okta_eventTypes category to break down.  Options: Access, Access Control, Application, Audit, Certification, Device, Directory, Group, Hooks, IAM, Integration, Lifecycle, Mim, OAuth2, PAM, PKI, Policy, Security, Support, System, User, Workflows.  Leave as * for every category.",
				"required": true,
				"defaultValue": "*",
				"previewValue": "*"
			}
		]
	},
	"Labels": [
		"okta"
	]
}