{
	"UUID": "29b12b24-877c-487c-a067-a02a733f18cb",
	"Name": "Template - Okta - Investigation - Authentication Outcomes by Country for Actor, Target, and/or IP [table]",
	"Description": "Groups authentication attempts matching the actor, target, and source address you enter by country and network operator, with successes and failures counted side by side. A country you do not operate in with a high success count is the row to chase.\n\nCountries and operators come from Okta's own client.geographicalContext and securityContext, falling back to the maxmind and asn_db resources from the Gravwell Network Enrichment kit only for events that arrive without them.\n\nAll three variables accept wildcards, and * matches everything.\n\nRenders as a table.\n\nReference(s):\n- https://developer.okta.com/docs/reference/api/event-types/\n- https://developer.okta.com/docs/api/openapi/okta-management/management/tag/SystemLog/",
	"Data": {
		"variables": [
			{
				"name": "%%1%%",
				"label": "Okta Actor",
				"description": "The account that performed the action, matched against actor.alternateId and actor.displayName.  Wildcards allowed; leave as * for any actor.",
				"required": true,
				"defaultValue": "*",
				"previewValue": "*"
			},
			{
				"name": "%%2%%",
				"label": "Okta Target",
				"description": "The account or object the action was performed against, matched against target.alternateId and target.displayName.  Wildcards allowed; leave as * for any target.",
				"required": true,
				"defaultValue": "*",
				"previewValue": "*"
			},
			{
				"name": "%%3%%",
				"label": "Okta IP",
				"description": "The source address, matched against client.ipAddress and the first hop of request.ipChain.  Wildcards allowed; leave as * for any address.",
				"required": true,
				"defaultValue": "*",
				"previewValue": "*"
			}
		]
	},
	"Labels": [
		"okta"
	]
}