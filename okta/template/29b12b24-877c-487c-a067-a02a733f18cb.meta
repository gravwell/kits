{
	"UUID": "29b12b24-877c-487c-a067-a02a733f18cb",
	"Name": "Template - Okta - Investigation - Authentication Events for Actor, Target, and/or IP by Country [table]",
	"Description": "Authentication events in the Okta System Log for an actor, target and/or IP, by the country of the client: events, successful and failed sign-ins, distinct actors and source IPs. Locations come from Okta (client.geographicalContext), with the geoip module (MaxMind, Network Enrichment kit) only for events Okta did not place.\n\nVariables are wildcard patterns:\n  - Okta Actor: actor alternate ID or display name\n  - Okta Target: target alternate ID or display name\n  - Okta IP: client IP or request IP",
	"Data": {
		"variables": [
			{
				"name": "%%1%%",
				"label": "Okta Actor",
				"description": "This is the user (actorAltId or actorName) who performed the action.",
				"required": true,
				"defaultValue": "*",
				"previewValue": "*"
			},
			{
				"name": "%%2%%",
				"label": "Okta Target",
				"description": "This is the user (targetAltId or targetName) whom the action was performed against.",
				"required": true,
				"defaultValue": "*",
				"previewValue": "*"
			},
			{
				"name": "%%3%%",
				"label": "Okta IP",
				"description": "This is either the clientIp or the requestIp from which the action was performed.",
				"required": true,
				"defaultValue": "*",
				"previewValue": "*"
			}
		]
	},
	"Labels": [
		"okta"
	]
}
