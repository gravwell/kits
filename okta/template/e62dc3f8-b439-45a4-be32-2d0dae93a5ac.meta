{
	"UUID": "e62dc3f8-b439-45a4-be32-2d0dae93a5ac",
	"Name": "Template - Okta - Investigation - Highest Risk Events for Actor, Target, and/or IP [table]",
	"Description": "Every Okta event matching the actor, target, and source address you enter, scored and sorted with the highest risk first. Unlike the configuration change view this keeps authentication and read activity too, so it is the right one for \"show me the worst thing this account did\".\n\nAll three variables accept wildcards, and * matches everything.\n\nRenders as a table sorted by risk score, highest first.\n\nReference(s):\n- https://developer.okta.com/docs/reference/api/event-types/\n- https://developer.okta.com/docs/api/openapi/okta-management/management/tag/SystemLog/",
	"Data": {
		"variables": [
			{
				"name": "%%1%%",
				"label": "Okta Actor",
				"description": "The account that performed the action, matched against actor.alternateId and actor.displayName.  Wildcards allowed; leave as * for any actor.",
				"required": true,
				"defaultValue": "*",
				"previewValue": "*"
			},
			{
				"name": "%%2%%",
				"label": "Okta Target",
				"description": "The account or object the action was performed against, matched against target.alternateId and target.displayName.  Wildcards allowed; leave as * for any target.",
				"required": true,
				"defaultValue": "*",
				"previewValue": "*"
			},
			{
				"name": "%%3%%",
				"label": "Okta IP",
				"description": "The source address, matched against client.ipAddress and the first hop of request.ipChain.  Wildcards allowed; leave as * for any address.",
				"required": true,
				"defaultValue": "*",
				"previewValue": "*"
			}
		]
	},
	"Labels": [
		"okta"
	]
}