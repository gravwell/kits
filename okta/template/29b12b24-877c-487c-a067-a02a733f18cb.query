$OKTA_ALERT_BASE
$OKTA_NORMALIZE_IP
$OKTA_COMBINED_AUTH
$OKTA_INVESTIGATION_SEARCH("%%1%%","%%2%%","%%3%%")
$OKTA_GEO
| eval ok = 0; failed = 0; if (loginDisposition == "success") { ok = 1; } else if (loginDisposition == "failure") { failed = 1; }
| stats count as events sum(ok) as successful sum(failed) as failed unique_count(actorAltId) as actors unique_count(src) as sources by geoCountry
| sort by events desc
| table geoCountry events successful failed actors sources
