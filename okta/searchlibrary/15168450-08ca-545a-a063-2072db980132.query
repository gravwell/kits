/* Okta - Admin & Configuration Changes - Okta API Token Created */
tag=$OKTA_SYSTEM json eventType == "system.api_token.create"
$OKTA_ALERT_EVX
$OKTA_ENRICH_COMMON
$OKTA_RISK_SCORE("catalog")
$OKTA_IP_TUNING
$OKTA_USER_TUNING
| eval _alert_name = "Okta API Token Created"
$OKTA_ALERT_META("Persistence", "T1136")