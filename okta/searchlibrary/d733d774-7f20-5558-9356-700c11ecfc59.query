/* Okta - Admin & Configuration Changes - Okta API Token Revoked */
tag=$OKTA_SYSTEM json eventType == "system.api_token.revoke"
$OKTA_ALERT_EVX
$OKTA_ENRICH_COMMON
$OKTA_RISK_SCORE("catalog")
$OKTA_IP_TUNING
$OKTA_USER_TUNING
| eval _alert_name = "Okta API Token Revoked"
$OKTA_ALERT_META("Impact", "T1531")