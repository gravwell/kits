/* Okta - Threats & Platform - Okta ThreatInsight Threat Suspected Promotion */
/* Any Okta event where ThreatInsight marks the request as suspected malicious (debugData.threatSuspected = true). */
tag=$OKTA_SYSTEM json debugContext.debugData.threatSuspected == "true"
$OKTA_ALERT_EVX
$OKTA_ENRICH_COMMON
$OKTA_RISK_SCORE("catalog")
$OKTA_IP_TUNING
$OKTA_USER_TUNING
| eval _alert_name = "Okta ThreatInsight Threat Suspected Promotion"
$OKTA_ALERT_META("Credential Access", "T1110")