// Okta user profile snapshots land on the OKTA_USERS tag, one JSON record per user.
tag=$OKTA_USERS
| json
	id
	profile.firstName as firstName
	profile.lastName as lastName
	profile.manager as manager
// The OKTA_USERS tag is a snapshot stream: the Gravwell Okta ingester re-publishes
// every user profile on each poll, so one user appears many times in any window.
// Collapse to one entry per Okta user id first, otherwise every number below is
// multiplied by the number of polls in the timeframe.
| unique id
// Okta leaves profile.manager unset for anyone with no manager, and some tenants
// put a boolean there instead of a name.  Fall back to the user's own name so the
// gap is visible rather than lumped into one empty category.
| eval
	managerDisplay = manager;
	if (!has(manager) || manager == "" || manager == "null" || match(manager, "(?i)^(true|false)$")) {
		managerDisplay = strings_trimspace(firstName + " " + lastName);
	}
| stats count by managerDisplay
| chart count by managerDisplay
