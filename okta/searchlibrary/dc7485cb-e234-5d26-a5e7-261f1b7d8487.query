/* Okta - Authentication & Sessions - Okta User Session Impersonation */
tag=$OKTA_SYSTEM json eventType == "user.session.impersonation.initiate"
$OKTA_ALERT_EVX
$OKTA_ENRICH_COMMON
$OKTA_RISK_SCORE("catalog")
$OKTA_IP_TUNING
$OKTA_USER_TUNING
| eval _alert_name = "Okta User Session Impersonation"
$OKTA_ALERT_META("Defense Evasion", "T1550")