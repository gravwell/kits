/* AlertQuery - Okta - Identity Access Management - User - Session - Okta User Session Impersonation [table] */
tag=$OKTA_SYSTEM ax eventType == "user.session.impersonation.initiate"
$OKTA_ALERT_EVX
$OKTA_ENRICH_COMMON
$OKTA_CATALOG_RISK_SCORE
$OKTA_IP_TUNING
$OKTA_USER_TUNING
| eval _alert_name = "Okta User Session Impersonation"
$OKTA_ALERT_META