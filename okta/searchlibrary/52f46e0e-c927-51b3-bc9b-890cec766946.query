/* AlertQuery - Okta - Identity Access Management - System - Event Types - Unauthorized Access to App [table] */
tag=$OKTA_SYSTEM
$OKTA_ALERT_EVX
| regex -e message "(?i)unauthorized access to app"
$OKTA_ENRICH_COMMON
$OKTA_CATALOG_RISK_SCORE
$OKTA_IP_TUNING
$OKTA_USER_TUNING
| eval _alert_name = "Unauthorized Access to App"
$OKTA_ALERT_META