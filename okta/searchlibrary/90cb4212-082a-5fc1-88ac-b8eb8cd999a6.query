/* AlertQuery - Okta - Identity Access Management - User - Authentication - Multiple Okta User Auth Events with Same Device Token Hash Behind a Proxy [table] */
tag=$OKTA_SYSTEM ax
| regex -e eventType "^user\.authentication\..*$"
$OKTA_ALERT_EVX
| regex -e dtHash ".*"
$OKTA_ENRICH_COMMON
$OKTA_CATALOG_RISK_SCORE
$OKTA_IP_TUNING
$OKTA_USER_TUNING
| eval _alert_name = "Multiple Okta User Auth Events with Same Device Token Hash Behind a Proxy"
$OKTA_ALERT_META