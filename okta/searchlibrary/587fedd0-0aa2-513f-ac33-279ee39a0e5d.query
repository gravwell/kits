/* AlertQuery - Okta - Identity Access Management - System - Event Types - Okta Brute Force or Password Spraying Attack [table] */
tag=$OKTA_SYSTEM ax
| regex -e eventType ".*auth.*"
$OKTA_ALERT_EVX
| regex -e outcomeResult "(?i)FAIL|DENY"
$OKTA_ENRICH_COMMON
$OKTA_CATALOG_RISK_SCORE
$OKTA_IP_TUNING
$OKTA_USER_TUNING
| eval _alert_name = "Okta Brute Force or Password Spraying Attack"
$OKTA_ALERT_META