/* Okta - Authentication & Sessions - Okta FastPass Phishing Detection */
tag=$OKTA_SYSTEM json eventType == "user.authentication.auth_via_mfa"
$OKTA_ALERT_EVX
| regex -e outcomeResult "(?i)FAIL.*"
| regex -e outcomeReason "(?i)FastPass declined phishing attempt"
$OKTA_ENRICH_COMMON
$OKTA_RISK_SCORE("catalog")
$OKTA_IP_TUNING
$OKTA_USER_TUNING
| eval _alert_name = "Okta FastPass Phishing Detection"
$OKTA_ALERT_META("Initial Access", "T1566")