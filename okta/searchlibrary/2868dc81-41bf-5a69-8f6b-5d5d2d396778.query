/* AlertQuery - Okta - Identity Access Management - User - Authentication - Okta FastPass Phishing Detection [table] */
tag=$OKTA_SYSTEM ax eventType == "user.authentication.auth_via_mfa"
$OKTA_ALERT_EVX
| regex -e outcomeResult "(?i)FAIL.*"
| regex -e outcomeReason "(?i)FastPass declined phishing attempt"
$OKTA_ENRICH_COMMON
$OKTA_CATALOG_RISK_SCORE
$OKTA_IP_TUNING
$OKTA_USER_TUNING
| eval _alert_name = "Okta FastPass Phishing Detection"
$OKTA_ALERT_META