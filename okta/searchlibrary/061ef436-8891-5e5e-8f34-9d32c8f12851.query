tag=$OKTA_USERS json id profile.userType as key type.id as userTypeId
| last id
| eval
    if (!has(key) || key == "" || key == "null") { key = userTypeId; }
    if (!has(key) || key == "" || key == "null") { key = "(none)"; }
| stats count by key
| eval key != "(none)"
| stats count
| alias count " "
| numbercard " "
