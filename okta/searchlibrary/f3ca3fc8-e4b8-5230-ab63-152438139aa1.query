/* AlertQuery - Okta - Identity Access Management - User - MFA - MFA Deactivation with no Re-Activation for Okta User Account [table] */
tag=$OKTA_SYSTEM ax
| regex -e eventType "^(?:user\.mfa\.factor\.deactivate|user\.mfa\.factor\.reset_all)$"
$OKTA_ALERT_EVX
| regex -e outcomeResult "(?i)SUCCESS"
| regex -e outcomeReason "(?i)User reset SECURITY\_QUESTION factor"
$OKTA_ENRICH_COMMON
$OKTA_CATALOG_RISK_SCORE
$OKTA_IP_TUNING
$OKTA_USER_TUNING
| eval _alert_name = "MFA Deactivation with no Re-Activation for Okta User Account"
$OKTA_ALERT_META