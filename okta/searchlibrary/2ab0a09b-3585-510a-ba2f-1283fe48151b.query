/* Okta - Authentication & Sessions - Okta Many Device Tokens from One IP on Failed Sign-Ins */
@agg{tag=$OKTA_SYSTEM json eventType actor.alternateId as actorAltId client.ipAddress as clientIp outcome.result as res outcome.reason as reason debugContext.debugData.dtHash as dtHash
| eval match(eventType, "^user\\.(session\\.start$|authentication\\.)") && res == "FAILURE" && match(reason, "INVALID_CREDENTIALS")
| stats count as n by clientIp dtHash
| stats count as hashes by clientIp
| eval hashes >= 10
| table clientIp hashes};
tag=$OKTA_SYSTEM json eventType outcome.result as res outcome.reason as reason
$OKTA_ALERT_EVX
| eval match(eventType, "^user\\.(session\\.start$|authentication\\.)") && res == "FAILURE" && match(reason, "INVALID_CREDENTIALS")
| lookup -s -r @agg clientIp clientIp hashes
| unique clientIp
$OKTA_ENRICH_COMMON
$OKTA_RISK_SCORE("catalog")
$OKTA_RISK_FLOOR("65")
$OKTA_IP_TUNING
$OKTA_USER_TUNING
| eval
    _alert_name = "Okta Many Device Tokens from One IP on Failed Sign-Ins";
    message = printf("%v different device token hashes on failed sign-ins from %v in the search window", hashes, clientIp);
$OKTA_ALERT_META("Credential Access", "T1110")