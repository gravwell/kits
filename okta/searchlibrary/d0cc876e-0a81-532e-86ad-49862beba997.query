/* Okta - Authentication & Sessions - Unauthorized Access to an Okta Application */
tag=$OKTA_SYSTEM json eventType == "app.generic.unauth_app_access_attempt"
$OKTA_ALERT_EVX
$OKTA_ENRICH_COMMON
$OKTA_RISK_SCORE("catalog")
$OKTA_IP_TUNING
$OKTA_USER_TUNING
| eval _alert_name = "Unauthorized Access to an Okta Application"
$OKTA_ALERT_META("Initial Access", "T1078")