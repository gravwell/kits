/* AlertQuery - Okta - Identity Access Management - Lifecycle - Application - Attempt to Modify an Okta Application [table] */
tag=$OKTA_SYSTEM ax eventType == "application.lifecycle.update"
$OKTA_ALERT_EVX
$OKTA_ENRICH_COMMON
$OKTA_CATALOG_RISK_SCORE
$OKTA_IP_TUNING
$OKTA_USER_TUNING
| eval _alert_name = "Attempt to Modify an Okta Application"
$OKTA_ALERT_META