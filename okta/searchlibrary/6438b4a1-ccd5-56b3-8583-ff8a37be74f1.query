/* AlertQuery - Okta - Identity Access Management - User - Authentication / MFA / Session - Potentially Successful Okta MFA Bombing via Push Notifications [table] */
tag=$OKTA_SYSTEM ax
| regex -e eventType "^(?:user\.mfa\.okta_verify\.deny_push|user\.authentication\.auth_via_mfa|user\.authentication\.sso|user\.authentication\.verify|user\.session\.start)$"
$OKTA_ALERT_EVX
| regex -e outcomeResult "(?i)SUCCESS|ALLOW"
| regex -e outcomeReason "(?i)(INVALID\_CREDENTIALS|INVALID|CREDENTIALS)"
| regex -e actorId "(?i).*"
$OKTA_ENRICH_COMMON
$OKTA_CATALOG_RISK_SCORE
$OKTA_IP_TUNING
$OKTA_USER_TUNING
| eval _alert_name = "Potentially Successful Okta MFA Bombing via Push Notifications"
$OKTA_ALERT_META