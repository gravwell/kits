/* AlertQuery - Okta - Identity Access Management - User - Session - Okta User Session Start Via An Anonymising Proxy Service [table] */
tag=$OKTA_SYSTEM ax eventType == "user.session.start"
$OKTA_ALERT_EVX
$OKTA_ENRICH_COMMON
$OKTA_CATALOG_RISK_SCORE
$OKTA_IP_TUNING
$OKTA_USER_TUNING
| eval _alert_name = "Okta User Session Start Via An Anonymising Proxy Service"
$OKTA_ALERT_META