/* AlertQuery - Okta - Identity Access Management - Policy - Rule - Okta Policy Rule Modified or Deleted [table] */
tag=$OKTA_SYSTEM ax
| regex -e eventType "^policy\.rule\.(?:update|delete)$"
$OKTA_ALERT_EVX
$OKTA_ENRICH_COMMON
$OKTA_CATALOG_RISK_SCORE
$OKTA_IP_TUNING
$OKTA_USER_TUNING
| eval _alert_name = "Okta Policy Rule Modified or Deleted"
$OKTA_ALERT_META