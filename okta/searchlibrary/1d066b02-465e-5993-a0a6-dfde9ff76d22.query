/* Okta - Authentication & Sessions - Okta Admin Console Access via Anonymizing Proxy */
tag=$OKTA_SYSTEM json eventType==user.session.access_admin_app securityContext.isProxy as isProxyRaw securityContext.risk.reasons as riskReasons
$OKTA_ALERT_EVX
| eval ((has("isProxyRaw") && isProxyRaw == "true") || (has("riskReasons") && riskReasons ~ "Anonymizing Proxy"))
$OKTA_ENRICH_COMMON
$OKTA_RISK_SCORE("catalog")
$OKTA_RISK_FLOOR("75")
$OKTA_IP_TUNING
$OKTA_USER_TUNING
| eval
    _alert_name = "Okta Admin Console Access via Anonymizing Proxy";
    message = "Okta Admin Console accessed through an anonymizing proxy";
$OKTA_ALERT_META("Initial Access", "T1078.004")