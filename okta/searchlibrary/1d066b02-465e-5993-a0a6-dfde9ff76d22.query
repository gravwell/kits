/* AlertQuery - Okta - Identity Access Management - System - Event Types - Okta Admin Functions Access Through Proxy [table] */
tag=$OKTA_SYSTEM
$OKTA_ALERT_EVX
| regex -e requestUri "(?i)\/admin"
$OKTA_ENRICH_COMMON
$OKTA_CATALOG_RISK_SCORE
$OKTA_IP_TUNING
$OKTA_USER_TUNING
| eval _alert_name = "Okta Admin Functions Access Through Proxy"
$OKTA_ALERT_META