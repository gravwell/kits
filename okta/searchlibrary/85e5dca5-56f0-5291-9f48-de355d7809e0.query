/* Okta - Authentication & Sessions - Attempted Bypass of Okta MFA */
tag=$OKTA_SYSTEM json eventType == "user.mfa.attempt_bypass"
$OKTA_ALERT_EVX
$OKTA_ENRICH_COMMON
$OKTA_RISK_SCORE("catalog")
$OKTA_IP_TUNING
$OKTA_USER_TUNING
| eval _alert_name = "Attempted Bypass of Okta MFA"
$OKTA_ALERT_META("Credential Access", "T1111")