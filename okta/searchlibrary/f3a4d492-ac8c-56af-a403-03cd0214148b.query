/* Okta - Account & MFA Changes - Locked Out or Account Locked */
tag=$OKTA_SYSTEM json eventType
| regex -e eventType "^user\.account\.lock(?:\.limit)?$"
$OKTA_ALERT_EVX
$OKTA_ENRICH_COMMON
$OKTA_RISK_SCORE("catalog")
$OKTA_IP_TUNING
$OKTA_USER_TUNING
| eval _alert_name = "Locked Out or Account Locked"
$OKTA_ALERT_META("Credential Access", "T1110")