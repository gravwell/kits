/* Okta - Account & MFA Changes - New Okta User Created */
tag=$OKTA_SYSTEM json eventType == "user.lifecycle.create"
$OKTA_ALERT_EVX
$OKTA_ENRICH_COMMON
$OKTA_RISK_SCORE("catalog")
$OKTA_IP_TUNING
$OKTA_USER_TUNING
| eval _alert_name = "New Okta User Created"
$OKTA_ALERT_META("Persistence", "T1136.003")