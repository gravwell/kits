tag=$OKTA_USERS json id lastLogin
| last id
| eval
    signInCat = "never";
    if (has(lastLogin) && lastLogin != "" && lastLogin != "null") {
        lastSignIn = time(lastLogin); signInAge = NOW - lastSignIn;
        if (signInAge < duration("24h")) { signInCat = "<24h"; }
        else if (signInAge < duration("7d")) { signInCat = "7d"; }
        else if (signInAge < duration("30d")) { signInCat = "30d"; }
        else if (signInAge < duration("90d")) { signInCat = "90d"; }
        else { signInCat = "> 90d"; }
    }
| eval n = 0; if (signInCat == "> 90d") { n = 1; }
| stats sum(n) as count
| alias count " "
| numbercard " "
