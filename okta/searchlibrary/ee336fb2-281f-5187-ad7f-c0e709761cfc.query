/* AlertQuery - Okta - Identity Access Management - Group - Privilege - Administrator Privileges Assigned to an Okta Group [table] */
tag=$OKTA_SYSTEM ax eventType == "group.privilege.grant"
$OKTA_ALERT_EVX
$OKTA_ENRICH_COMMON
$OKTA_CATALOG_RISK_SCORE
$OKTA_IP_TUNING
$OKTA_USER_TUNING
| eval _alert_name = "Administrator Privileges Assigned to an Okta Group"
$OKTA_ALERT_META