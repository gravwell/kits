/* Okta - Admin & Configuration Changes - Okta Application Modified, Deactivated or Deleted */
tag=$OKTA_SYSTEM json eventType
| regex -e eventType "^application\.lifecycle\.(?:update|deactivate|delete)$"
$OKTA_ALERT_EVX
$OKTA_ENRICH_COMMON
$OKTA_RISK_SCORE("catalog")
$OKTA_IP_TUNING
$OKTA_USER_TUNING
| eval _alert_name = "Okta Application Modified, Deactivated or Deleted"
$OKTA_ALERT_META("Impact", "T1489")