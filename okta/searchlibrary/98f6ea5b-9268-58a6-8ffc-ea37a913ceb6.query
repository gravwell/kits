/* AlertQuery - Okta - Identity Access Management - System - Event Types - New sign-on behavior [table] */
tag=$OKTA_SYSTEM
$OKTA_ALERT_EVX
| regex -e message "(?i)New sign\-on behavior"
$OKTA_ENRICH_COMMON
$OKTA_CATALOG_RISK_SCORE
$OKTA_IP_TUNING
$OKTA_USER_TUNING
| eval _alert_name = "New sign-on behavior"
$OKTA_ALERT_META