/* Okta - Threats & Platform - Possible Okta DoS Attack */
/* Okta rate-limit and concurrency-limit violations. Includes the event types Okta emits today (system.operation / system.client */
/* rate_limit and concurrency_rate_limit violations) as well as the older org-level and integration names. */
tag=$OKTA_SYSTEM json eventType
| regex -e eventType "^(?:system\.operation\.rate_limit\.violation|system\.client\.rate_limit\.violation|system\.client\.concurrency_rate_limit\.violation|system\.org\.rate_limit\.warning|system\.org\.rate_limit\.violation|application\.integration\.rate_limit_exceeded|core\.concurrency\.org\.limit\.violation)$"
$OKTA_ALERT_EVX
$OKTA_ENRICH_COMMON
$OKTA_RISK_SCORE("catalog")
$OKTA_RISK_FLOOR("55")
$OKTA_IP_TUNING
$OKTA_USER_TUNING
| eval _alert_name = "Possible Okta DoS Attack"
$OKTA_ALERT_META("Impact", "T1498")
