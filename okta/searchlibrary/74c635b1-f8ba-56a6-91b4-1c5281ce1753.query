/* AlertQuery - Okta - Identity Access Management - User - MFA - Attempt to Reset MFA Factors for an Okta User Account [table] */
tag=$OKTA_SYSTEM ax
| regex -e eventType "user.mfa.factor.reset"
$OKTA_ALERT_EVX
$OKTA_ENRICH_COMMON
$OKTA_CATALOG_RISK_SCORE
$OKTA_IP_TUNING
$OKTA_USER_TUNING
| eval _alert_name = "Attempt to Reset MFA Factors for an Okta User Account"
$OKTA_ALERT_META