/* AlertQuery - Okta - Identity Access Management - Access Control - Network Zones - Okta Network Zone Deactivated or Deleted [table] */
tag=$OKTA_SYSTEM ax
| regex -e eventType "^zone\.(?:deactivate|delete)$"
$OKTA_ALERT_EVX
$OKTA_ENRICH_COMMON
$OKTA_CATALOG_RISK_SCORE
$OKTA_IP_TUNING
$OKTA_USER_TUNING
| eval _alert_name = "Okta Network Zone Deactivated or Deleted"
$OKTA_ALERT_META