/* Okta - Admin & Configuration Changes - Okta Network Zone Modified, Deactivated or Deleted */
tag=$OKTA_SYSTEM json eventType
| regex -e eventType "^(?:zone\.(?:update|deactivate|delete|remove_blacklist)|network_zone\.rule\.disabled)$"
$OKTA_ALERT_EVX
$OKTA_ENRICH_COMMON
$OKTA_RISK_SCORE("catalog")
$OKTA_IP_TUNING
$OKTA_USER_TUNING
| eval _alert_name = "Okta Network Zone Modified, Deactivated or Deleted"
$OKTA_ALERT_META("Defense Evasion", "T1562")