/* AlertQuery - Okta - Identity Access Management - Policy - Application - Modification or Removal of an Okta Application Sign-On Policy [table] */
tag=$OKTA_SYSTEM ax
| regex -e eventType "policy\.sign_on\.(?:update|delete)"
$OKTA_ALERT_EVX
$OKTA_ENRICH_COMMON
$OKTA_CATALOG_RISK_SCORE
$OKTA_IP_TUNING
$OKTA_USER_TUNING
| eval _alert_name = "Modification or Removal of an Okta Application Sign-On Policy"
$OKTA_ALERT_META