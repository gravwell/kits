/* AlertQuery - Okta - Identity Access Management - Policy - Rule - Attempt to Delete an Okta Policy Rule [table] */
tag=$OKTA_SYSTEM ax eventType == "policy.rule.delete"
$OKTA_ALERT_EVX
$OKTA_ENRICH_COMMON
$OKTA_CATALOG_RISK_SCORE
$OKTA_IP_TUNING
$OKTA_USER_TUNING
| eval _alert_name = "Attempt to Delete an Okta Policy Rule"
$OKTA_ALERT_META