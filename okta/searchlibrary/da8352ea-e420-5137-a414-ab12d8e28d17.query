/* Okta - Authentication & Sessions - Okta Password Spray from One Device */
@agg{tag=$OKTA_SYSTEM json eventType actor.alternateId as actorAltId client.ipAddress as clientIp outcome.result as res outcome.reason as reason debugContext.debugData.dtHash as dtHash
| eval match(eventType, "^user\\.(session\\.start$|authentication\\.)") && res == "FAILURE" && match(reason, "INVALID_CREDENTIALS")
| stats count as n by dtHash actorAltId
| stats count as users sum(n) as failures by dtHash
| eval users >= 3
| table dtHash users failures};
tag=$OKTA_SYSTEM json eventType outcome.result as res outcome.reason as reason
$OKTA_ALERT_EVX
| eval match(eventType, "^user\\.(session\\.start$|authentication\\.)") && res == "FAILURE" && match(reason, "INVALID_CREDENTIALS")
| lookup -s -r @agg dtHash dtHash (users failures)
| unique dtHash
$OKTA_ENRICH_COMMON
$OKTA_RISK_SCORE("catalog")
$OKTA_RISK_FLOOR("75")
$OKTA_IP_TUNING
$OKTA_USER_TUNING
| eval
    _alert_name = "Okta Password Spray from One Device";
    message = printf("%v failed sign-ins with invalid credentials for %v different users from one device token in the search window", failures, users);
$OKTA_ALERT_META("Credential Access", "T1110.003")