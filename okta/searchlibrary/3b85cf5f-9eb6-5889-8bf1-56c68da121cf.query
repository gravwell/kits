/* AlertQuery - Okta - Identity Access Management - Access Control - Network Zones - Attempt to Delete an Okta Network Zone [table] */
tag=$OKTA_SYSTEM ax eventType == "zone.delete"
$OKTA_ALERT_EVX
$OKTA_ENRICH_COMMON
$OKTA_CATALOG_RISK_SCORE
$OKTA_IP_TUNING
$OKTA_USER_TUNING
| eval _alert_name = "Attempt to Delete an Okta Network Zone"
$OKTA_ALERT_META