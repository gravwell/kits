/* AlertQuery - Okta - Identity Access Management - Lifecycle - System API - Attempt to Create Okta API Token [table] */
tag=$OKTA_SYSTEM ax eventType == "system.api_token.create"
$OKTA_ALERT_EVX
$OKTA_ENRICH_COMMON
$OKTA_CATALOG_RISK_SCORE
$OKTA_IP_TUNING
$OKTA_USER_TUNING
| eval _alert_name = "Attempt to Create Okta API Token"
$OKTA_ALERT_META