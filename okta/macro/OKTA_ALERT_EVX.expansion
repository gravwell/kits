| json
    eventType
    severity
    outcome.result as outcomeResult
    displayMessage as message
    actor.id as actorId
    actor.type as actorType
    actor.alternateId as actorAltId
    actor.displayName as actorName
    client.ipAddress as clientIp
    published
    securityContext.isProxy as isProxy
    debugContext.debugData.requestUri as requestUri
    debugContext.debugData.behaviors as debugBehavior
    debugContext.debugData.logOnlySecurityData as debugLogOnlySecData
    debugContext.debugData.dtHash as dtHash
    debugContext.debugData.threatSuspected as threatSuspect
    outcome.reason as outcomeReason
    request.ipChain.[].ip as requestIp
    client.device as clientDevice
    authenticationContext.externalSessionId as authExternalSessionId
    target
| json -x target
| json -e target
    id as targetId
    type as targetType
    alternateId as targetAltId
    displayName as targetName