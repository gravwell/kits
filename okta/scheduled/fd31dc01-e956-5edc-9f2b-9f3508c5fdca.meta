{
  "Name": "ScheduledSearch - Okta - Identity Access Management - System - Alert Catalog - Multiple Device Token Hashes for Single Okta Session",
  "Description": "This rule detects when a specific Okta actor has multiple device token hashes for a single Okta session. This may indicate an authenticated session has been hijacked or is being used by multiple devices. Adversaries may hijack a session to gain unauthorized access to Okta admin console, applications, tenants, or other resources.\n\nReference(s):\n- https://detection.fyi/elastic/detection-rules/integrations/okta/credential_access_multiple_device_token_hashes_for_single_okta_session/\n- https://github.com/elastic/detection-rules/blob/main/rules/integrations/okta/credential_access_multiple_device_token_hashes_for_single_okta_session.toml",
  "Labels": [
    "okta"
  ],
  "Schedule": "*/15 * * * *",
  "Duration": -900,
  "DefaultDeploymentRules": {
    "Disabled": true,
    "RunImmediately": false
  },
  "ScheduledType": "search",
  "GUID": "fd31dc01-e956-5edc-9f2b-9f3508c5fdca",
  "SearchReference": "9e2cd5fc-5c1f-5e06-9f1e-25b6f06cc8a4"
}