{
  "Name": "ScheduledSearch - Okta - Identity Access Management - User - Authentication / Session - Multiple Okta User Authentication Events with Client Address",
  "Description": "Detects when a certain threshold of Okta user authentication events are reported for multiple users from the same client address. Adversaries may attempt to launch a credential stuffing or password spraying attack from the same device by using a list of known usernames and passwords to gain unauthorized access to user accounts.\n\nReference(s):\n- https://detection.fyi/elastic/detection-rules/integrations/okta/credential_access_multiple_device_token_hashes_for_single_okta_session/\n- https://github.com/elastic/detection-rules/tree/main/rules/integrations/okta/credential_access_okta_authentication_for_multiple_users_from_single_source.toml",
  "Labels": [
    "okta"
  ],
  "Schedule": "*/15 * * * *",
  "Duration": -900,
  "DefaultDeploymentRules": {
    "Disabled": true,
    "RunImmediately": false
  },
  "ScheduledType": "search",
  "GUID": "98e3ea52-80d6-5ea2-85e9-210abbe575b6",
  "SearchReference": "0eeb706e-23c8-5fac-9358-5ee4a2227d2f"
}