{"id":"gravwell@0.0.1","nodes":{"1":{"id":1,"data":{"macros":{"type":"Array","array_elements":[{"type":"Constant","value":"GRAVWELL_INSTANCE"},{"type":"Constant","value":"OKTA_ALERT_SENDER"},{"type":"Constant","value":"OKTA_ALERT_RECIPIENT"}]},"__meta":{"nickname":"Read Okta config macros","notes":null,"inputs":[],"values":{"macros":[{"type":{"kind":"string"},"value":"GRAVWELL_INSTANCE"},{"type":{"kind":"string"},"value":"OKTA_ALERT_SENDER"},{"type":{"kind":"string"},"value":"OKTA_ALERT_RECIPIENT"}]}},"__disabled":{"type":"Constant","value":false}},"inputs":{"in":{"connections":[]}},"outputs":{"out":{"connections":[{"node":2,"input":"in","data":{}}]}},"position":[144,-384],"name":"MacroGet"},"2":{"id":2,"data":{"template":{"type":"Constant","value":"<html>\n<head>\n  <style>\n    body { font-family: -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; color: #1a1a1a; }\n    table { border-collapse: collapse; width: 100%; margin-bottom: 20px; }\n    th, td { border: 1px solid #d8d8d8; padding: 6px 9px; text-align: left; font-size: 14px; vertical-align: top; }\n    th { background-color: #f2f2f2; }\n    h1 { font-size: 19px; margin: 0 0 6px 0; }\n    h2 { font-size: 15px; margin: 22px 0 8px 0; color: #444; }\n    .label { width: 210px; background-color: #fafafa; font-weight: 600; }\n    .muted { color: #666; font-size: 13px; margin: 0 0 18px 0; }\n  </style>\n</head>\n<body>\n  <h1>{{ .event.Metadata.AlertName }}</h1>\n  <p class=\"muted\">Okta Alert Router &middot; {{ .event.Metadata.Created }}</p>\n\n  <h2>What fired</h2>\n  <table>\n    <tr>\n      <td class=\"label\">Detection</td>\n      <td><a href=\"{{ .GRAVWELL_INSTANCE }}/scheduler/{{ .event.Metadata.Dispatcher.ID }}\">{{ .event.Metadata.Dispatcher.Name }}</a></td>\n    </tr>\n    <tr>\n      <td class=\"label\">Alert</td>\n      <td><a href=\"{{ .GRAVWELL_INSTANCE }}/alerts/{{ .event.Metadata.AlertID }}\">{{ .event.Metadata.AlertName }}</a></td>\n    </tr>\n    <tr>\n      <td class=\"label\">Results</td>\n      <td><a href=\"{{ .GRAVWELL_INSTANCE }}/search/{{ .event.Metadata.Dispatcher.SearchID }}\">Open the search that produced this</a></td>\n    </tr>\n  </table>\n\n  <h2>Key fields</h2>\n  <table>\n    <tr><td class=\"label\">Okta event type</td><td>{{ .event.Contents.eventType }}</td></tr>\n    <tr><td class=\"label\">Okta timestamp</td><td>{{ .event.Contents.published }}</td></tr>\n    <tr><td class=\"label\">Priority</td><td>{{ .event.Contents._priority }} (risk {{ .event.Contents.risk_score }})</td></tr>\n    <tr><td class=\"label\">Actor</td><td>{{ .event.Contents.actorAltId }}</td></tr>\n    <tr><td class=\"label\">Target</td><td>{{ .event.Contents.targetUser }}</td></tr>\n    <tr><td class=\"label\">Source address</td><td>{{ .event.Contents.src }}</td></tr>\n    <tr><td class=\"label\">Source location</td><td>{{ .event.Contents.srcCity }} {{ .event.Contents.srcCountry }} &middot; {{ .event.Contents.srcASNOrg }}</td></tr>\n    <tr><td class=\"label\">Outcome</td><td>{{ .event.Contents.outcomeResult }} {{ .event.Contents.outcomeReason }}</td></tr>\n    <tr><td class=\"label\">Okta category</td><td>{{ .event.Contents.category }} / {{ .event.Contents.subcategory }}</td></tr>\n    <tr><td class=\"label\">Okta message</td><td>{{ .event.Contents.message }}</td></tr>\n  </table>\n\n  <h2>Every field on the event</h2>\n  <p class=\"muted\">Detections ship raw Okta entries, so every enumerated value the\n  query produced is here. Detections whose name ends in [table] aggregate instead,\n  and carry the columns of that aggregation.</p>\n  {{- if .event.Contents }}\n  <table>\n    {{- range $key, $value := .event.Contents }}\n    <tr>\n      <td class=\"label\">{{ $key }}</td>\n      <td>{{ $value }}</td>\n    </tr>\n    {{- end }}\n  </table>\n  {{- else }}\n  <p>No event contents available.</p>\n  {{- end }}\n</body>\n</html>"},"name":{"type":"Constant","value":"templateOutput"},"__meta":{"nickname":"Render alert email","notes":null,"inputs":[],"values":{"template":{"type":{"kind":"string:longtext"},"value":"<html>\n<head>\n  <style>\n    body { font-family: -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; color: #1a1a1a; }\n    table { border-collapse: collapse; width: 100%; margin-bottom: 20px; }\n    th, td { border: 1px solid #d8d8d8; padding: 6px 9px; text-align: left; font-size: 14px; vertical-align: top; }\n    th { background-color: #f2f2f2; }\n    h1 { font-size: 19px; margin: 0 0 6px 0; }\n    h2 { font-size: 15px; margin: 22px 0 8px 0; color: #444; }\n    .label { width: 210px; background-color: #fafafa; font-weight: 600; }\n    .muted { color: #666; font-size: 13px; margin: 0 0 18px 0; }\n  </style>\n</head>\n<body>\n  <h1>{{ .event.Metadata.AlertName }}</h1>\n  <p class=\"muted\">Okta Alert Router &middot; {{ .event.Metadata.Created }}</p>\n\n  <h2>What fired</h2>\n  <table>\n    <tr>\n      <td class=\"label\">Detection</td>\n      <td><a href=\"{{ .GRAVWELL_INSTANCE }}/scheduler/{{ .event.Metadata.Dispatcher.ID }}\">{{ .event.Metadata.Dispatcher.Name }}</a></td>\n    </tr>\n    <tr>\n      <td class=\"label\">Alert</td>\n      <td><a href=\"{{ .GRAVWELL_INSTANCE }}/alerts/{{ .event.Metadata.AlertID }}\">{{ .event.Metadata.AlertName }}</a></td>\n    </tr>\n    <tr>\n      <td class=\"label\">Results</td>\n      <td><a href=\"{{ .GRAVWELL_INSTANCE }}/search/{{ .event.Metadata.Dispatcher.SearchID }}\">Open the search that produced this</a></td>\n    </tr>\n  </table>\n\n  <h2>Key fields</h2>\n  <table>\n    <tr><td class=\"label\">Okta event type</td><td>{{ .event.Contents.eventType }}</td></tr>\n    <tr><td class=\"label\">Okta timestamp</td><td>{{ .event.Contents.published }}</td></tr>\n    <tr><td class=\"label\">Priority</td><td>{{ .event.Contents._priority }} (risk {{ .event.Contents.risk_score }})</td></tr>\n    <tr><td class=\"label\">Actor</td><td>{{ .event.Contents.actorAltId }}</td></tr>\n    <tr><td class=\"label\">Target</td><td>{{ .event.Contents.targetUser }}</td></tr>\n    <tr><td class=\"label\">Source address</td><td>{{ .event.Contents.src }}</td></tr>\n    <tr><td class=\"label\">Source location</td><td>{{ .event.Contents.srcCity }} {{ .event.Contents.srcCountry }} &middot; {{ .event.Contents.srcASNOrg }}</td></tr>\n    <tr><td class=\"label\">Outcome</td><td>{{ .event.Contents.outcomeResult }} {{ .event.Contents.outcomeReason }}</td></tr>\n    <tr><td class=\"label\">Okta category</td><td>{{ .event.Contents.category }} / {{ .event.Contents.subcategory }}</td></tr>\n    <tr><td class=\"label\">Okta message</td><td>{{ .event.Contents.message }}</td></tr>\n  </table>\n\n  <h2>Every field on the event</h2>\n  <p class=\"muted\">Detections ship raw Okta entries, so every enumerated value the\n  query produced is here. Detections whose name ends in [table] aggregate instead,\n  and carry the columns of that aggregation.</p>\n  {{- if .event.Contents }}\n  <table>\n    {{- range $key, $value := .event.Contents }}\n    <tr>\n      <td class=\"label\">{{ $key }}</td>\n      <td>{{ $value }}</td>\n    </tr>\n    {{- end }}\n  </table>\n  {{- else }}\n  <p>No event contents available.</p>\n  {{- end }}\n</body>\n</html>"},"name":{"type":{"default":"templateOutput","kind":"string"},"value":"templateOutput"}}},"__disabled":{"type":"Constant","value":false}},"inputs":{"in":{"connections":[{"node":1,"output":"out","data":{}}]}},"outputs":{"out":{"connections":[{"node":3,"input":"in","data":{}}]}},"position":[368,-384],"name":"Template"},"3":{"id":3,"data":{"from":{"type":"Variable","value":"OKTA_ALERT_SENDER"},"to":{"type":"Array","array_elements":[{"type":"Variable","value":"OKTA_ALERT_RECIPIENT"}]},"cc":{"type":"Array","array_elements":[]},"bcc":{"type":"Array","array_elements":[]},"subject":{"type":"Variable","value":"event.Metadata.Dispatcher.Name"},"body":{"type":"Variable","value":"templateOutput"},"attachment":{"type":"Array","array_elements":[]},"__meta":{"nickname":"Email the SOC","notes":null,"inputs":[],"values":{"from":{"type":{"kind":"variable"},"value":"OKTA_ALERT_SENDER"},"to":[{"type":{"kind":"variable"},"value":"OKTA_ALERT_RECIPIENT"}],"cc":[],"bcc":[],"subject":{"type":{"kind":"variable"},"value":"event.Metadata.Dispatcher.Name"},"body":{"type":{"kind":"variable"},"value":"templateOutput"},"attachment":[]}},"__disabled":{"type":"Constant","value":false}},"inputs":{"in":{"connections":[{"node":2,"output":"out","data":{}}]}},"outputs":{"out":{"connections":[]}},"position":[592,-384],"name":"Email"}}}