{
  "Name": "ScheduledSearch - Okta - Identity Access Management - Lifecycle - System API - Attempt to Create Okta API Token",
  "Description": "Detects attempts to create an Okta API token. An adversary may create an Okta API token to maintain access to an organization's network while they work to achieve their objectives. An attacker may abuse an API token to execute techniques such as creating user accounts or disabling security rules or policies.\n\nReference(s):\n- https://detection.fyi/elastic/detection-rules/integrations/okta/persistence_attempt_to_create_okta_api_token/\n- https://github.com/elastic/detection-rules/tree/main/rules/integrations/okta/persistence_attempt_to_create_okta_api_token.toml",
  "Labels": [
    "okta"
  ],
  "Schedule": "*/15 * * * *",
  "Duration": -900,
  "DefaultDeploymentRules": {
    "Disabled": true,
    "RunImmediately": false
  },
  "ScheduledType": "search",
  "GUID": "57d80f4c-1f5d-525c-a875-62fbcedcde5a",
  "SearchReference": "43923775-2b56-57ec-a208-5bdd711e5bec"
}