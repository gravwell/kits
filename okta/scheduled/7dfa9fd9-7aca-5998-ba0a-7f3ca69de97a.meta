{
  "Name": "ScheduledSearch - Okta - Identity Access Management - User - Authentication / Session - Multiple Okta User Authentication Events with Same Device Token Hash",
  "Description": "Detects when a high number of Okta user authentication events are reported for multiple users in a short time frame. Adversaries may attempt to launch a credential stuffing or password spraying attack from the same device by using a list of known usernames and passwords to gain unauthorized access to user accounts.\n\nReference(s):\n- https://detection.fyi/elastic/detection-rules/integrations/okta/credential_access_okta_authentication_for_multiple_users_with_the_same_device_token_hash/\n- https://github.com/elastic/detection-rules/blob/main/rules/integrations/okta/credential_access_okta_authentication_for_multiple_users_with_the_same_device_token_hash.toml",
  "Labels": [
    "okta"
  ],
  "Schedule": "*/15 * * * *",
  "Duration": -900,
  "DefaultDeploymentRules": {
    "Disabled": true,
    "RunImmediately": false
  },
  "ScheduledType": "search",
  "GUID": "7dfa9fd9-7aca-5998-ba0a-7f3ca69de97a",
  "SearchReference": "da8352ea-e420-5137-a414-ab12d8e28d17"
}