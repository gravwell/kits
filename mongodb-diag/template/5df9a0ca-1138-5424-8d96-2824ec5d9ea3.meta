{
	"UUID": "5df9a0ca-1138-5424-8d96-2824ec5d9ea3",
	"Name": "Template - MongoDB - Database - Diagnostics - Investigation - Count by Severity [numbercard]",
	"Description": "This is intended to show a numbercard of MongoDB Diagnostics events by structured log severity for the investigation scope.",
	"Data": {
		"variables": [
			{
				"name": "%%identity%%",
				"label": "User / Principal / Client / Context",
				"description": "What MongoDB user, principal, application, client, or context are you investigating?",
				"required": true,
				"defaultValue": ".",
				"previewValue": "."
			},
			{
				"name": "%%ip%%",
				"label": "Remote IP / Host / Client",
				"description": "What remote address, client address, or host are you investigating?",
				"required": true,
				"defaultValue": ".",
				"previewValue": "."
			},
			{
				"name": "%%namespace%%",
				"label": "Namespace / Database / Collection",
				"description": "What namespace, database, or collection are you investigating?",
				"required": true,
				"defaultValue": ".",
				"previewValue": "."
			},
			{
				"name": "%%component%%",
				"label": "Component",
				"description": "What MongoDB log component are you investigating?",
				"required": true,
				"defaultValue": ".",
				"previewValue": "."
			}
		]
	},
	"Labels": [
		"mongodb",
		"mongodb-diag"
	]
}