/* Template - MongoDB - Database - Diagnostics - Investigation - Count by Message [numbercard] */
tag=$MONGODB_DIAG ax 
$MONGODB_DIAG_ENRICH_COMMON
| regex -e _diag_identity "%%identity%%" 
| regex -e  _diag_ip "%%ip%%" 
| regex -e  _diag_namespace "%%namespace%%" 
| regex -e  _diag_component "%%component%%"
| stats count by _diag_event_type
| numbercard (count " ")