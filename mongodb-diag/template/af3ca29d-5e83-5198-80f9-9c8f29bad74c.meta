{
	"UUID": "af3ca29d-5e83-5198-80f9-9c8f29bad74c",
	"Name": "Template - MongoDB - Database - Diagnostics - Investigation - Total Events [numbercard]",
	"Description": "This is intended to show a numbercard of total MongoDB Diagnostics events for the identity, IP, namespace, or component that you are investigating.",
	"Data": {
		"variables": [
			{
				"name": "%%identity%%",
				"label": "User / Principal / Client / Context",
				"description": "What MongoDB user, principal, application, client, or context are you investigating?",
				"required": true,
				"defaultValue": ".",
				"previewValue": "."
			},
			{
				"name": "%%ip%%",
				"label": "Remote IP / Host / Client",
				"description": "What remote address, client address, or host are you investigating?",
				"required": true,
				"defaultValue": ".",
				"previewValue": "."
			},
			{
				"name": "%%namespace%%",
				"label": "Namespace / Database / Collection",
				"description": "What namespace, database, or collection are you investigating?",
				"required": true,
				"defaultValue": ".",
				"previewValue": "."
			},
			{
				"name": "%%component%%",
				"label": "Component",
				"description": "What MongoDB log component are you investigating?",
				"required": true,
				"defaultValue": ".",
				"previewValue": "."
			}
		]
	},
	"Labels": [
		"mongodb",
		"mongodb-diag"
	]
}