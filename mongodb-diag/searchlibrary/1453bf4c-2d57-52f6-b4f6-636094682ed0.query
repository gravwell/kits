/* AlertQuery - MongoDB - Database - Diagnostics - Alerts - Slow Query With No Index Use [table]*/
tag=$MONGODB_DIAG ax 
| eval log_id == 51803
| eval has(keysExamined) && keysExamined == 0
| eval has(docsExamined) && docsExamined >= 10000
| eval _alert_name = "Slow Query With No Index Use";
$MONGODB_DIAG_ENRICH_COMMON
$MONGODB_DIAG_RISK_SCORE
$MONGODB_DIAG_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _severity context