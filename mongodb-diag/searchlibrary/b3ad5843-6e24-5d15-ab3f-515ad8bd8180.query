/* AlertQuery - MongoDB - Database - Diagnostics - Alerts - Command Error [table]*/
tag=$MONGODB_DIAG ax 
| eval has(error) || has(errorCode) || has(errorLabels) || has(code) || has(codeName) || has(errorMessage)
| eval _alert_name = "Command Error";
$MONGODB_DIAG_ENRICH_COMMON
$MONGODB_DIAG_RISK_SCORE
$MONGODB_DIAG_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _severity context