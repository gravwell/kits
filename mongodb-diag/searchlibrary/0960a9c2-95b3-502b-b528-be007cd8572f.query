/* AlertQuery - MongoDB - Database - Diagnostics - Alerts - Large Response Returned [table]*/
tag=$MONGODB_DIAG ax 
| eval has(responseLength) && responseLength >= 10485760
| eval _alert_name = "Large Response Returned";
$MONGODB_DIAG_ENRICH_COMMON
$MONGODB_DIAG_RISK_SCORE
$MONGODB_DIAG_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _severity context