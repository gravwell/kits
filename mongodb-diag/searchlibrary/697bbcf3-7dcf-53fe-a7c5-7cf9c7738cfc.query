/* AlertQuery - MongoDB - Database - Diagnostics - Alerts - WiredTiger Recovery Activity [table]*/
tag=$MONGODB_DIAG ax
| regex -e component "^(RECOVERY|WTRECOV|WTRTS)$"
| eval _alert_name = "WiredTiger Recovery Activity";
$MONGODB_DIAG_ENRICH_COMMON
$MONGODB_DIAG_RISK_SCORE
$MONGODB_DIAG_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _severity context