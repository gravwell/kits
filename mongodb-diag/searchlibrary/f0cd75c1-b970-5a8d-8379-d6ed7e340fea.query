/* AlertQuery - MongoDB - Database - Diagnostics - Alerts - User Or Role Admin Command Logged [table]*/
tag=$MONGODB_DIAG ax
| regex -e commandName "^(createUser|updateUser|dropUser|grantRolesToUser|revokeRolesFromUser|createRole|updateRole|dropRole|grantPrivilegesToRole|revokePrivilegesFromRole)$"
| eval _alert_name = "User or Role Admin Command Logged";
$MONGODB_DIAG_ENRICH_COMMON
$MONGODB_DIAG_RISK_SCORE
$MONGODB_DIAG_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _severity context