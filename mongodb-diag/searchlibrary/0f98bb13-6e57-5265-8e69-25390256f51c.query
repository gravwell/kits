/* AlertQuery - MongoDB - Database - Diagnostics - Alerts - Write Operation Slow [table]*/
tag=$MONGODB_DIAG ax
| regex -e commandName "^(insert|update|delete|findAndModify|bulkWrite)$"
| eval (has(durationMillis) && durationMillis >= 5000) || (has(millis) && millis >= 5000)
| eval _alert_name = "Write Operation Slow";
$MONGODB_DIAG_ENRICH_COMMON
$MONGODB_DIAG_RISK_SCORE
$MONGODB_DIAG_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _severity context