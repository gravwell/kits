/* AlertQuery - MongoDB - Database - Diagnostics - Alerts - Slow Query Over 30 Seconds [table]*/
tag=$MONGODB_DIAG ax 
| eval 
    log_id == 51803;
    (has(durationMillis) && durationMillis >= 30000) || (has(millis) && millis >= 30000);
| eval _alert_name = "Slow Query Over 30 Seconds";
$MONGODB_DIAG_ENRICH_COMMON
$MONGODB_DIAG_RISK_SCORE
$MONGODB_DIAG_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _severity context