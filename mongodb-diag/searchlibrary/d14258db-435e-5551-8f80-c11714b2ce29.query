/* AlertQuery - MongoDB - Database - Diagnostics - Alerts - Insecure Startup Warning [table]*/
tag=$MONGODB_DIAG ax
| regex -e message "(?i)access control|authorization|authentication|not enabled|unrestricted|localhost|bind|tls|ssl|certificate|keyfile|security"
| eval 
    tags~"startupWarnings";
    _alert_name = "Insecure Startup Warnings";
$MONGODB_DIAG_ENRICH_COMMON
$MONGODB_DIAG_RISK_SCORE
$MONGODB_DIAG_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _severity context