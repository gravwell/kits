/* AlertQuery - MongoDB - Database - Diagnostics - Alerts - Unexpected Mongo Shell Client [table]*/
tag=$MONGODB_DIAG ax
| regex -e document "(?i)mongosh|mongo shell|MongoDB Shell"
| eval 
    log_id == 51800;
    _alert_name = "Unexpected Mongo Shell Client";
$MONGODB_DIAG_ENRICH_COMMON
$MONGODB_DIAG_RISK_SCORE
$MONGODB_DIAG_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _severity context