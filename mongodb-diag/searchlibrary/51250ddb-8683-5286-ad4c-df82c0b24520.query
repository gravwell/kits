/* AlertQuery - MongoDB - Database - Diagnostics - Alerts - Long Running Operation [table]*/
tag=$MONGODB_DIAG ax 
| eval (has(durationMillis) && durationMillis >= 60000) || (has(millis) && millis >= 60000)
| eval _alert_name = "Long Running Operation";
$MONGODB_DIAG_ENRICH_COMMON
$MONGODB_DIAG_RISK_SCORE
$MONGODB_DIAG_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _severity context