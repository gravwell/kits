/* AlertQuery - MongoDB - Database - Diagnostics - Alerts - Debug Logging Enabled [table]*/
tag=$MONGODB_DIAG ax
| regex -e severity "^D[1-5]$"
| eval _alert_name = "Debug Logging Enabled";
| count by severity component
| sort by count desc
$MONGODB_DIAG_ENRICH_COMMON
$MONGODB_DIAG_RISK_SCORE
$MONGODB_DIAG_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _severity context count