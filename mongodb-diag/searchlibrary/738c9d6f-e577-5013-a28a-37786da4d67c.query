/* AlertQuery - MongoDB - Database - Diagnostics - Alerts - Authentication Failure Spike By Remote [table]*/
tag=$MONGODB_DIAG ax
| eval component == "ACCESS"
| regex -e message "(?i)auth|authentication|authenticate|fail|failed|failure|denied|unauthorized|not authorized|invalid"
| eval _alert_name = "Authentication Failure Spike By Remote";
$MONGODB_DIAG_ENRICH_COMMON
$MONGODB_DIAG_RISK_SCORE
$MONGODB_DIAG_ALERT_META
| count by remote user principalName authenticationDatabase mechanism errorCode codeName
| sort by count desc
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _severity context count