/* AlertQuery - MongoDB - Database - Diagnostics - Alerts - Replica Set Reconfiguration Command Logged [table]*/
tag=$MONGODB_DIAG ax
| eval 
    commandName == "replSetReconfig";
    _alert_name = "Replica Set Reconfiguration Command Logged";
$MONGODB_DIAG_ENRICH_COMMON
$MONGODB_DIAG_RISK_SCORE
$MONGODB_DIAG_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _severity context