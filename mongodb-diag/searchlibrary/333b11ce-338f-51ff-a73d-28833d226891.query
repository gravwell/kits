/* AlertQuery - MongoDB - Database - Diagnostics - Alerts - High Scan Low Return [table]*/
tag=$MONGODB_DIAG ax 
| eval has(docsExamined) && has(nReturned) && docsExamined >= 100000 && nReturned <= 100
| eval _alert_name = "High Scan Low Return";
$MONGODB_DIAG_ENRICH_COMMON
$MONGODB_DIAG_RISK_SCORE
$MONGODB_DIAG_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _severity context