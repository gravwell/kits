/* AlertQuery - MongoDB - Database - Diagnostics - Alerts - Component Error Spike [table]*/
tag=$MONGODB_DIAG ax
| regex -e severity "^(F|E|W)$"
| eval _alert_name = "Component Error Spike";
$MONGODB_DIAG_ENRICH_COMMON
$MONGODB_DIAG_RISK_SCORE
$MONGODB_DIAG_ALERT_META
| count by severity component log_id message
| sort by count desc
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _severity context