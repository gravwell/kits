/* AlertQuery - MongoDB - Database - Diagnostics - Alerts - Primary Election Or Stepdown [table]*/
tag=$MONGODB_DIAG ax
| regex -e component "^(ELECTION|REPL)$"
| regex -e message "(?i)election|primary|stepdown|step down|became primary|transition to primary|transition to secondary|new primary"
| eval _alert_name = "Primary Election Or Stepdown";
$MONGODB_DIAG_ENRICH_COMMON
$MONGODB_DIAG_RISK_SCORE
$MONGODB_DIAG_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _severity context