/* AlertQuery - MongoDB - Database - Diagnostics - Alerts - Error Code Spike [table]*/
tag=$MONGODB_DIAG ax 
| eval has(errorCode) || has(code) || has(codeName) || has(errorMessage)
| eval _alert_name = "Error Code Spike";
| count by component errorCode code codeName errorMessage
| sort by count desc
$MONGODB_DIAG_ENRICH_COMMON
$MONGODB_DIAG_RISK_SCORE
$MONGODB_DIAG_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _severity context count