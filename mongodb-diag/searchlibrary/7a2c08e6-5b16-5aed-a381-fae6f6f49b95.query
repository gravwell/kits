/* AlertQuery - MongoDB - Database - Diagnostics - Alerts - Warning Spike By Message [table]*/
tag=$MONGODB_DIAG ax
| eval 
    severity == "W";
    _alert_name = "Warning Spike by Message";
| count by component log_id message
| sort by count desc
$MONGODB_DIAG_ENRICH_COMMON
$MONGODB_DIAG_RISK_SCORE
$MONGODB_DIAG_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _severity context