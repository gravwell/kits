/* AlertQuery - MongoDB - Database - Diagnostics - Alerts - Connection Churn By Remote [table]*/
tag=$MONGODB_DIAG ax
| regex -e message"(?i)connection accepted|accepted connection|connection ended|end connection|client disconnect|connection closed|connection reset"
| eval 
    component == "NETWORK";
    _alert_name = "Connection Churn by Remote";
| count by remote address
| sort by count desc
$MONGODB_DIAG_ENRICH_COMMON
$MONGODB_DIAG_RISK_SCORE
$MONGODB_DIAG_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _severity context count