/* AlertQuery - MongoDB - Database - Diagnostics - Alerts - TLS Or Certificate Error [table]*/
tag=$MONGODB_DIAG ax
| regex -e severity "^(F|E|W)$"
| regex -e message "(?i)tls|ssl|certificate|cert|x509|handshake|cipher|keyfile"
| eval _alert_name = "TLS Or Certificate Error";
$MONGODB_DIAG_ENRICH_COMMON
$MONGODB_DIAG_RISK_SCORE
$MONGODB_DIAG_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _severity context