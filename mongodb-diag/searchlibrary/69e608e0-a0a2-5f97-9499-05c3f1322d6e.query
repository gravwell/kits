/* AlertQuery - MongoDB - Database - Diagnostics - Alerts - Connection Accepted Spike By Remote [table]*/
tag=$MONGODB_DIAG ax
| regex -e message "(?i)connection accepted|accepted connection"
| eval 
    component == "NETWORK";
    _alert_name = "Connection Accepted Spike by Remote";
| count by remote address
| sort by count desc
$MONGODB_DIAG_ENRICH_COMMON
$MONGODB_DIAG_RISK_SCORE
$MONGODB_DIAG_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _severity context count