/* AlertQuery - MongoDB - Database - Diagnostics - Alerts - High Risk Administrative Command Logged [table]*/
tag=$MONGODB_DIAG ax
| regex -e commandName "^(drop|dropDatabase|dropIndexes|renameCollection|createUser|updateUser|dropUser|grantRolesToUser|revokeRolesFromUser|createRole|updateRole|dropRole|grantPrivilegesToRole|revokePrivilegesFromRole|replSetReconfig|shutdown|setFeatureCompatibilityVersion|setParameter|createIndexes)$"
| eval _alert_name = "High Risk Administrative Command Logged";
$MONGODB_DIAG_ENRICH_COMMON
$MONGODB_DIAG_RISK_SCORE
$MONGODB_DIAG_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _severity context