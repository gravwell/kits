/* AlertQuery - MongoDB - Database - Diagnostics - Alerts - Shard Administrative Command Logged [table]*/
tag=$MONGODB_DIAG ax
| regex -e commandName "^(addShard|removeShard|enableSharding|shardCollection|refineCollectionShardKey|moveChunk|moveRange|split|mergeChunks|balancerStart|balancerStop)$"
| eval _alert_name = "Shard Administrative Command Logged";
$MONGODB_DIAG_ENRICH_COMMON
$MONGODB_DIAG_RISK_SCORE
$MONGODB_DIAG_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _severity context