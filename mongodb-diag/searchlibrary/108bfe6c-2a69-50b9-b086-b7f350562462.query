/* AlertQuery - MongoDB - Database - Diagnostics - Alerts - Process Startup [table]*/
tag=$MONGODB_DIAG ax
| eval component == "CONTROL"
| regex -e message "(?i)MongoDB starting|db version|options set by command line|options set by configuration file|initializing"
| eval _alert_name = "Process Startup";
$MONGODB_DIAG_ENRICH_COMMON
$MONGODB_DIAG_RISK_SCORE
$MONGODB_DIAG_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _severity context