/* AlertQuery - MongoDB - Database - Diagnostics - Alerts - Storage Warning Or Error [table]*/
tag=$MONGODB_DIAG ax
| regex -e severity "^(F|E|W)$"
| regex -e component "^(STORAGE|JOURNAL|RECOVERY|WT|WTBACKUP|WTCHKPT|WTCMPCT|WTEVICT|WTHS|WTRECOV|WTRTS|WTSLVG|WTTS|WTTXN|WTVRFY|WTWRTLOG)$"
| eval _alert_name = "Storage Warning Or Error";
$MONGODB_DIAG_ENRICH_COMMON
$MONGODB_DIAG_RISK_SCORE
$MONGODB_DIAG_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _severity context