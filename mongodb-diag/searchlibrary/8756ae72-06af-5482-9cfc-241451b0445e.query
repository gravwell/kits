/* AlertQuery - MongoDB - Database - Diagnostics - Alerts - Replication Warning Or Error [table]*/
tag=$MONGODB_DIAG ax
| regex -e severity "^(F|E|W)$"
| regex -e component "^(REPL|REPL_HB|ELECTION|INITSYNC|ROLLBACK)$"
| eval _alert_name = "Replication Warning Or Error";
$MONGODB_DIAG_ENRICH_COMMON
$MONGODB_DIAG_RISK_SCORE
$MONGODB_DIAG_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _severity context