tag=$SLACK_AUDIT ax action actorName detailExportType locationName
| eval in(action, "channels_export_started", "channels_export_downloaded", "manual_export_started", "manual_export_downloaded", "manual_user_export_started", "manual_user_export_downloaded", "scheduled_export_started", "scheduled_export_downloaded", "corporate_exports_enabled", "corporate_exports_approved")
| table action actorName detailExportType locationName
