/* Template - MongoDB - Database - Audit - Investigation - Count by Result [numbercard] */
tag=$MONGODB_AUDIT ax user localIp remoteIp result
| eval (user ~ "%%user%%" && (localIp ~ "%%ip%%" || remoteIp ~ "%%ip%%"))
| lookup -r mongodb-audit-result-codes result result (resultName)
| stats count by resultName
| numbercard (count " ")