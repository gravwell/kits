/* AlertQuery - MongoDB - Database - Audit - Alerts - Privileges Revoked From Role [table]*/
tag=$MONGODB_AUDIT ax timestamp actionType == "revokePrivilegesFromRole" result == 0 user userDatabase role roleDatabase localIp remoteIp privileges param roles
| eval message = "Privileges Revoked From Role";
