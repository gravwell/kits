/* AlertQuery - MongoDB - Database - Audit - Alerts - Index Dropped [table]*/
tag=$MONGODB_AUDIT ax timestamp actionType == "dropIndex" result == 0 user userDatabase localIp remoteIp database namespace indexName param roles
| eval message = "Index Dropped";
