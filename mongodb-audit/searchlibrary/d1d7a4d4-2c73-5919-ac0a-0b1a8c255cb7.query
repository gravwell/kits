/* AlertQuery - MongoDB - Database - Audit - Alerts - All Roles Dropped From Database [table]*/
tag=$MONGODB_AUDIT ax timestamp actionType == "dropAllRolesFromDatabase" result == 0 user userDatabase localIp remoteIp database paramUser param roles
| eval message = "All Roles Dropped From Database";
