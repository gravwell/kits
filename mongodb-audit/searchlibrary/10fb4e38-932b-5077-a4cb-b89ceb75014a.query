/* AlertQuery - MongoDB - Database - Audit - Alerts - Role Granted To User [table]*/
tag=$MONGODB_AUDIT ax timestamp actionType == "grantRolesToUser" result == 0 user userDatabase role roleDatabase localIp remoteIp paramUser database paramRoles param roles
| eval message = "Role Granted To User";
$MONGODB_AUDIT_ENRICH_COMMON
$MONGODB_AUDIT_RISK_SCORE
$MONGODB_AUDIT_ALERT_META
| table timestamp actionType result user userDatabase role roleDatabase localIp remoteIp paramUser database paramRoles param roles