/* AlertQuery - MongoDB - Database - Audit - Alerts - Privileges Granted To Role [table]*/
tag=$MONGODB_AUDIT ax timestamp actionType == "grantPrivilegesToRole" result == 0 user userDatabase role roleDatabase localIp remoteIp privileges param roles
| eval message = "Privileges Granted To Role";
$MONGODB_AUDIT_ENRICH_COMMON
$MONGODB_AUDIT_RISK_SCORE
$MONGODB_AUDIT_ALERT_META
| table timestamp actionType result user userDatabase role roleDatabase localIp remoteIp privileges param roles