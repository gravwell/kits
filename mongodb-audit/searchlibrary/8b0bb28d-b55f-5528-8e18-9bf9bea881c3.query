/* AlertQuery - MongoDB - Database - Audit - Alerts - High Risk Administrative Action [table]*/
tag=$MONGODB_AUDIT ax timestamp actionType~"^(createUser|updateUser|dropUser|dropAllUsersFromDatabase|grantRolesToUser|revokeRolesFromUser|createRole|updateRole|dropRole|dropAllRolesFromDatabase|grantPrivilegesToRole|revokePrivilegesFromRole|directAuthMutation|dropDatabase|dropCollection|dropIndex|renameCollection|replSetReconfig|addShard|removeShard|enableSharding|shardCollection|setClusterParameter|shutdown)$" result == 0 user userDatabase role roleDatabase localIp remoteIp database namespace command args param roles
| eval message = "High Risk Administrative Action";
$MONGODB_AUDIT_ENRICH_COMMON
$MONGODB_AUDIT_RISK_SCORE
$MONGODB_AUDIT_ALERT_META
| table timestamp actionType result user userDatabase role roleDatabase localIp remoteIp database namespace command args param roles