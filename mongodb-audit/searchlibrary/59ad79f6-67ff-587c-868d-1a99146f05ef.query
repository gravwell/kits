/* AlertQuery - MongoDB - Database - Audit - Alerts - Sharding Enabled [table]*/
tag=$MONGODB_AUDIT ax timestamp actionType == "enableSharding" result == 0 user userDatabase localIp remoteIp database namespace command args param roles
| eval message = "Sharding Enabled";
$MONGODB_AUDIT_ENRICH_COMMON
$MONGODB_AUDIT_RISK_SCORE
$MONGODB_AUDIT_ALERT_META
| table timestamp actionType result user userDatabase localIp remoteIp database namespace command args param roles