/* AlertQuery - MongoDB - Atlas - Admin API - Atlas Events - OAuth Audit Event Observed [table]*/
tag=$MONGODB_ATLAS_EVENTS ax
| regex -e eventTypeName "^OAUTH_(CLIENT_CREATED|CLIENT_UPDATED|CLIENT_DELETED|CLIENT_SECRET_CREATED|CLIENT_SECRET_DELETED|AUTHORIZATION_GRANTED|AUTHORIZATION_DENIED|TOKEN_ISSUED|TOKEN_REVOKED|USER_CONSENT_GRANTED|USER_CONSENT_REVOKED)$"
| eval _alert_name = "OAuth Audit Event Observed";
$MONGODB_ATLAS_ENRICH_COMMON
$MONGODB_ATLAS_RISK_SCORE
$MONGODB_ATLAS_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _status context