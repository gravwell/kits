/* AlertQuery - MongoDB - Atlas - Admin API - Project Activity Events - Backup Control Plane Change [table]*/
tag=$MONGODB_ATLAS_ACTIVITY ax
| regex -e eventTypeName "^(CPS_DATA_PROTECTION_(DISABLED|DISABLE_REQUESTED|UPDATED|UPDATE_REQUESTED)|CPS_RESTORE_REQUESTED_AUDIT|RESTORE_REQUESTED_AUDIT|CPS_SNAPSHOT_DELETED_AUDIT|CPS_SNAPSHOT_RETENTION_MODIFIED_AUDIT|CPS_SNAPSHOT_SCHEDULE_UPDATED_AUDIT|RS_CREDENTIAL_UPDATED_AUDIT|RS_DENYLIST_UPDATED_AUDIT|RS_BLACKLIST_UPDATED_AUDIT|RS_ROTATE_MASTER_KEY_AUDIT|RS_SNAPSHOT_SCHEDULE_UPDATED_AUDIT)$"
| eval _alert_name = "Backup Control Plan Change";
$MONGODB_ATLAS_ENRICH_COMMON
$MONGODB_ATLAS_RISK_SCORE
$MONGODB_ATLAS_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _status context