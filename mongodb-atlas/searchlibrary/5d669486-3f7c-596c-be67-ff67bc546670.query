/* AlertQuery - MongoDB - Atlas - Admin API - Atlas Events - Open Threshold or Rate Limit Alert [table]*/
tag=$MONGODB_ATLAS_EVENTS ax
| regex -e eventTypeName "^(OUTSIDE_FLEX_METRIC_THRESHOLD|OUTSIDE_METRIC_THRESHOLD|OUTSIDE_REALM_METRIC_THRESHOLD|OUTSIDE_SERVERLESS_METRIC_THRESHOLD|OUTSIDE_SPACE_USED_THRESHOLD|OUTSIDE_STREAM_PROCESSOR_METRIC_THRESHOLD|REQUEST_RATE_LIMIT|DAILY_BILL_OVER_THRESHOLD|DAILY_BILLING_CHANGE_OVER_THRESHOLD|ORG_WEEKLY_BILLING_CHANGE_OVER_THRESHOLD|ORG_MONTHLY_BILLING_CHANGE_OVER_THRESHOLD)$"
| eval 
	status == "OPEN";
	_alert_name = "Open Threshold or Rate Limit Alert";
$MONGODB_ATLAS_ENRICH_COMMON
$MONGODB_ATLAS_RISK_SCORE
$MONGODB_ATLAS_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _status context