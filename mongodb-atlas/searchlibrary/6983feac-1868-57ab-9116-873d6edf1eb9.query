/* AlertQuery - MongoDB - Atlas - Admin API - Project Activity Events - Project Security Checkup Degraded [table]*/
tag=$MONGODB_ATLAS_ACTIVITY ax
| regex -e eventTypeName "^(HOST_SECURITY_CHECKUP_NOT_MET|HOST_EXPOSED|SECURITY_CHECKUP_ALERTS_UPDATED)$"
| eval _alert_name = "Project Security Checkuop Degraded";
$MONGODB_ATLAS_ENRICH_COMMON
$MONGODB_ATLAS_RISK_SCORE
$MONGODB_ATLAS_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _status context