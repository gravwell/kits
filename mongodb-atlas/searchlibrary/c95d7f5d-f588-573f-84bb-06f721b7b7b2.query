/* AlertQuery - MongoDB - Atlas - Admin API - Project Activity Events - Alert Configuration Tampering [table]*/
tag=$MONGODB_ATLAS_ACTIVITY ax
| regex -e eventTypeName "^ALERT_CONFIG_(CHANGED|DELETED|DISABLED|ENABLED)_AUDIT$"
| eval _alert_name = "Alert Configuration Tampering";
$MONGODB_ATLAS_ENRICH_COMMON
$MONGODB_ATLAS_RISK_SCORE
$MONGODB_ATLAS_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _status context