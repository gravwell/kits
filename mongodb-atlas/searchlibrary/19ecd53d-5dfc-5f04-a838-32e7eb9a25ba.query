/* AlertQuery - MongoDB - Atlas - Admin API - Network Access - Temporary Network Access Entry [table]*/
tag=$MONGODB_ATLAS_NETWORK_ACCESS ax
| regex -e deleteAfterDate ".+"
| eval _alert_name = "Temporary Network Access Entry";
$MONGODB_ATLAS_ENRICH_COMMON
$MONGODB_ATLAS_RISK_SCORE
$MONGODB_ATLAS_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _status context