/* AlertQuery - MongoDB - Atlas - Admin API - Service Accounts - High Privilege Service Account [table]*/
tag=$MONGODB_ATLAS_SERVICE_ACCOUNTS ax
| regex -e roles "(?i)(ORG_OWNER|ORG_GROUP_CREATOR|ORG_BILLING_ADMIN|ORG_STREAM_PROCESSING_ADMIN|GROUP_OWNER|GROUP_CLUSTER_MANAGER|GROUP_DATA_ACCESS_ADMIN|GROUP_DATA_ACCESS_READ_WRITE|GROUP_SEARCH_INDEX_EDITOR)"
| eval _alert_name = "High Privilege Service Account";
$MONGODB_ATLAS_ENRICH_COMMON
$MONGODB_ATLAS_RISK_SCORE
$MONGODB_ATLAS_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _status context