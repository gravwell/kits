/* AlertQuery - MongoDB - Atlas - Admin API - Alerts - Open Backup or Data Protection Alert [table]*/
tag=$MONGODB_ATLAS_ALERTS ax
| regex -e eventTypeName "^(BACKUP_AGENT_DOWN|BACKUP_UNSUPPORTED|BAD_CLUSTERSHOTS|CPS_SNAPSHOT_FAILED|CPS_SNAPSHOT_BEHIND|CPS_PREV_SNAPSHOT_OLD|CPS_RESTORE_FAILED|CPS_OPLOG_BEHIND|CPS_EXPORT_FAILED|CPS_DATA_PROTECTION_DISABLED|CPS_DATA_PROTECTION_DISABLE_REQUESTED|RESYNC_REQUIRED)$"
| eval 
	status == "OPEN";
	_alert_name = "Open Backup or Data Protection Alert";
$MONGODB_ATLAS_ENRICH_COMMON
$MONGODB_ATLAS_RISK_SCORE
$MONGODB_ATLAS_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _status context