/* AlertQuery - MongoDB - Atlas - Admin API - Alerts - Open Atlas Search Node Alert [table]*/
tag=$MONGODB_ATLAS_ALERTS ax
| regex -e eventTypeName "^(HOST_MONGOT_APPROACHING_STOP_REPLICATION|HOST_MONGOT_CRASHING_OOM|HOST_MONGOT_PAUSE_INITIAL_SYNC|HOST_MONGOT_STOP_REPLICATION|HOST_SEARCH_NODE_INDEX_FAILED|HOST_SEARCH_PROCESS_THROTTLING)$"
| eval 
	status == "OPEN";
	_alert_name = "Open Atlas Search Node Alert";
$MONGODB_ATLAS_ENRICH_COMMON
$MONGODB_ATLAS_RISK_SCORE
$MONGODB_ATLAS_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _status context