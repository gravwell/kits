/* AlertQuery - MongoDB - Atlas - Admin API - Project Activity Events - Custom Database Role Lifecycle Change [table]*/
tag=$MONGODB_ATLAS_ACTIVITY ax
| regex -e eventTypeName "^MONGODB_ROLE_(ADDED|DELETED|UPDATED)$"
| eval _alert_name = "Custom Database Role Lifecycle Change";
$MONGODB_ATLAS_ENRICH_COMMON
$MONGODB_ATLAS_RISK_SCORE
$MONGODB_ATLAS_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _status context