/* AlertQuery - MongoDB - Atlas - Admin API - Project Activity Events - Maintenance Control Weakened [table]*/
tag=$MONGODB_ATLAS_ACTIVITY ax
| regex -e eventTypeName "^ATLAS_MAINTENANCE_(AUTO_DEFER_DISABLED|AUTO_DEFER_ENABLED|DEFERRED|DEFERRED_BY_ADMIN|PROTECTED_HOURS_CREATED|PROTECTED_HOURS_MODIFIED|PROTECTED_HOURS_REMOVED|RESET_BY_ADMIN)$"
| eval _alert_name = "Maintenance Control Weakened";
$MONGODB_ATLAS_ENRICH_COMMON
$MONGODB_ATLAS_RISK_SCORE
$MONGODB_ATLAS_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _status context