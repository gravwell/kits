/* AlertQuery - MongoDB - Atlas - Admin API - Project Activity Events - Atlas Log Download [table]*/
tag=$MONGODB_ATLAS_ACTIVITY ax
| regex -e eventTypeName "^(MONGODB_LOGS_DOWNLOADED|MONGOT_LOGS_DOWNLOADED|MONGOSQLD_LOGS_DOWNLOADED)$"
| eval _alert_name = "Atlas Log Download";
$MONGODB_ATLAS_ENRICH_COMMON
$MONGODB_ATLAS_RISK_SCORE
$MONGODB_ATLAS_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _status context