/* AlertQuery - MongoDB - Atlas - Admin API - Atlas Events - Organization Service Account Secret Risk [table]*/
tag=$MONGODB_ATLAS_EVENTS ax
| regex -e eventTypeName "^(ORG_SERVICE_ACCOUNT_SECRETS_EXPIRED|ORG_SERVICE_ACCOUNT_SECRETS_EXPIRING|ORG_SERVICE_ACCOUNT_MAX_SECRET_VALIDITY_EDITED)$"
| eval _alert_name = "Organization Service Account Secret Risk";
$MONGODB_ATLAS_ENRICH_COMMON
$MONGODB_ATLAS_RISK_SCORE
$MONGODB_ATLAS_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _status context