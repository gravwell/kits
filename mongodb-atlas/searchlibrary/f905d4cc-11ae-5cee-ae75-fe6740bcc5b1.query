/* AlertQuery - MongoDB - Atlas - Admin API - Cloud Backups - Backup Failure Status [table]*/
tag=$MONGODB_ATLAS_BACKUPS ax
| regex -e status "(?i)(FAILED|CANCELED|CANCELLED|EXPIRED|FALLBACK_FAILED|ERROR)"
| eval _alert_name = "Backup Failure Status";
$MONGODB_ATLAS_ENRICH_COMMON
$MONGODB_ATLAS_RISK_SCORE
$MONGODB_ATLAS_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _status context