/* AlertQuery - MongoDB - Atlas - Admin API - Programmatic API Keys - High Privilege API Key [table]*/
tag=$MONGODB_ATLAS_API_KEYS ax
| regex -e roleName "(?i)^(ORG_OWNER|GROUP_OWNER|Project Owner|Organization Owner|atlasAdmin|root|dbAdminAnyDatabase|userAdminAnyDatabase|readWriteAnyDatabase|clusterAdmin|backup|restore)$"
| eval _alert_name = "High Privilege API Key";
$MONGODB_ATLAS_ENRICH_COMMON
$MONGODB_ATLAS_RISK_SCORE
$MONGODB_ATLAS_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _status context