/* AlertQuery - MongoDB - Atlas - Admin API - Atlas Events - Organization UI or Public API Access List Change [table]*/
tag=$MONGODB_ATLAS_EVENTS ax
| regex -e eventTypeName "^(ORG_UI_IP_ACCESS_LIST_DISABLED|ORG_UI_IP_ACCESS_LIST_ENABLED|ORG_PUBLIC_API_ACCESS_LIST_REQUIRED|ORG_PUBLIC_API_ACCESS_LIST_NOT_REQUIRED)$"
| eval _alert_name = "Organization UI or Public API Access List Change";
$MONGODB_ATLAS_ENRICH_COMMON
$MONGODB_ATLAS_RISK_SCORE
$MONGODB_ATLAS_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _status context