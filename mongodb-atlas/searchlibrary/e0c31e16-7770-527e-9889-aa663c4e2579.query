/* AlertQuery - MongoDB - Atlas - Admin API - Clusters - Cluster Client Log Redaction Disabled [table]*/
tag=$MONGODB_ATLAS_CLUSTERS ax
| eval 
	redactClientLogData == "false";
	_alert_name = "Cluster Client Log Redaction Disabled";
$MONGODB_ATLAS_ENRICH_COMMON
$MONGODB_ATLAS_RISK_SCORE
$MONGODB_ATLAS_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _status context