/* AlertQuery - MongoDB - Atlas - Admin API - Atlas Events - Service Account Event Observed [table]*/
tag=$MONGODB_ATLAS_EVENTS ax
| regex -e eventTypeName "^SERVICE_ACCOUNT_(CREATED|DELETED|ROLES_CHANGED|DETAILS_CHANGED|ADDED_TO_GROUP|REMOVED_FROM_GROUP|ACCESS_LIST_ENTRY_ADDED|ACCESS_LIST_ENTRY_DELETED|SECRET_ADDED|SECRET_DELETED|UI_IP_ACCESS_LIST_INHERITANCE_ENABLED|UI_IP_ACCESS_LIST_INHERITANCE_DISABLED)$"
| eval _alert_name = "Service Account Event Observed";
$MONGODB_ATLAS_ENRICH_COMMON
$MONGODB_ATLAS_RISK_SCORE
$MONGODB_ATLAS_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _status context