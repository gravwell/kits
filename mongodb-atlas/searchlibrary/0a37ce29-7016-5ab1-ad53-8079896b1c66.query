/* AlertQuery - MongoDB - Atlas - Admin API - Alerts - Tracking Critical Atlas Alert [table]*/
tag=$MONGODB_ATLAS_ALERTS ax
| regex -e eventTypeName "^(HOST_DOWN|NO_PRIMARY|HOST_EXPOSED|HOST_NOT_ENOUGH_DISK_SPACE|OUTSIDE_METRIC_THRESHOLD|OUTSIDE_SPACE_USED_THRESHOLD|HOST_ROLLBACK|REQUEST_RATE_LIMIT|REPLICATION_OPLOG_WINDOW_RUNNING_OUT|BACKUP_AGENT_DOWN|CPS_SNAPSHOT_FAILED|CPS_SNAPSHOT_BEHIND|CPS_RESTORE_FAILED|CPS_OPLOG_BEHIND)$"
| eval
	status == "TRACKING";
	_alert_name = "Tracking Critical Atlas Alert";
$MONGODB_ATLAS_ENRICH_COMMON
$MONGODB_ATLAS_RISK_SCORE
$MONGODB_ATLAS_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _status context