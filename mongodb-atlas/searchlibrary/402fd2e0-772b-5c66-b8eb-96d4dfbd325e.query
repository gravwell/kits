/* AlertQuery - MongoDB - Atlas - Admin API - Organization Users - Pending or Invited Organization User [table]*/
tag=$MONGODB_ATLAS_ORG_USERS ax
| regex -e orgMembershipStatus "(?i)(INVITED|PENDING)"
| eval _alert_name = "Pending or Invited Organization User";
$MONGODB_ATLAS_ENRICH_COMMON
$MONGODB_ATLAS_RISK_SCORE
$MONGODB_ATLAS_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _status context