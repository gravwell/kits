/* AlertQuery - MongoDB - Atlas - Admin API - Project Activity Events - MongoDB Employee Support Access [table]*/
tag=$MONGODB_ATLAS_ACTIVITY ax
| regex -e eventTypeName "^(ALERT_HOST_SSH_SESSION_STARTED|RESTRICTED_EMPLOYEE_ACCESS_BYPASS)$"
| eval _alert_name = "MongoDB Employee Support Access";
$MONGODB_ATLAS_ENRICH_COMMON
$MONGODB_ATLAS_RISK_SCORE
$MONGODB_ATLAS_ALERT_META
| table _alert_title _vendor _product _category _subcategory _priority _alert_name _who _ip _status context