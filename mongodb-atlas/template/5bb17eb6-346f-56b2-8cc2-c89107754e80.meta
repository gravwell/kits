{
	"UUID": "5bb17eb6-346f-56b2-8cc2-c89107754e80",
	"Name": "Template - MongoDB - Atlas - Admin API - Investigation - Count by Event Type [numbercard]",
	"Description": "This is intended to show a numbercard of MongoDB Atlas events by Atlas eventTypeName, alert typeName, metricName, auth result, or state name.",
	"Data": {
		"variables": [
			{
				"name": "%%user%%",
				"label": "User/API Key/Service Account",
				"description": "What Atlas user, API key public key, service account client ID, or acknowledging username are you investigating?",
				"required": true,
				"defaultValue": ".",
				"previewValue": "."
			},
			{
				"name": "%%ip%%",
				"label": "IP/CIDR",
				"description": "What remote IP address, access-list IP, or CIDR block are you investigating?",
				"required": true,
				"defaultValue": ".",
				"previewValue": "."
			},
			{
				"name": "%%scopeId%%",
				"label": "Project Group ID/Org ID",
				"description": "What Atlas project groupId or organization orgId are you investigating?",
				"required": true,
				"defaultValue": "*",
				"previewValue": "*"
			},
			{
				"name": "%%eventTypeName%%",
				"label": "Event Type",
				"description": "What Atlas eventTypeName, alert typeName, metricName, auth result, or state name are you investigating?",
				"required": true,
				"defaultValue": "_",
				"previewValue": "_"
			}
		]
	},
	"Labels": [
		"mongodb",
		"mongodb-atlas"
	]
}