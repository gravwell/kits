{
	"UUID": "e1b651e2-55b7-500f-bfe0-d0a632bf374d",
	"Name": "Template - MongoDB - Atlas - Admin API - Investigation - Total Events [numbercard]",
	"Description": "This is intended to show a numbercard of total MongoDB Atlas Admin API events for the user, IP/CIDR, scope, or event type that you are investigating within the time frame that you specify.",
	"Data": {
		"variables": [
			{
				"name": "%%user%%",
				"label": "User/API Key/Service Account",
				"description": "What Atlas user, API key public key, service account client ID, or acknowledging username are you investigating?",
				"required": true,
				"defaultValue": ".",
				"previewValue": "."
			},
			{
				"name": "%%ip%%",
				"label": "IP/CIDR",
				"description": "What remote IP address, access-list IP, or CIDR block are you investigating?",
				"required": true,
				"defaultValue": ".",
				"previewValue": "."
			},
			{
				"name": "%%scopeId%%",
				"label": "Project Group ID/Org ID",
				"description": "What Atlas project groupId or organization orgId are you investigating?",
				"required": true,
				"defaultValue": "*",
				"previewValue": "*"
			},
			{
				"name": "%%eventTypeName%%",
				"label": "Event Type",
				"description": "What Atlas eventTypeName, alert typeName, metricName, auth result, or state name are you investigating?",
				"required": true,
				"defaultValue": "_",
				"previewValue": "_"
			}
		]
	},
	"Labels": [
		"mongodb",
		"mongodb-atlas"
	]
}