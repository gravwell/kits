tag=$WINDOWS_LOGON winlog EventID==4624 SubjectUserName TargetUserSid
// Exclude builtin users and local system auths
| eval ( !(strings_hassuffix(SubjectUserName,"$") == true && (TargetUserSid ~ "S-1-5-80" || TargetUserSid ~ "S-1-5-82" || TargetUserSid ~ "S-1-5-90" || TargetUserSid ~ "S-1-5-96")) && !((SubjectUserName == "-" || strings_hassuffix(SubjectUserName,"$") == true) && TargetUserSid == "S-1-5-18") )
| stats count
| chart count