tag=$AUDITD kv -q type as auditType name
| eval (auditType == "PATH")
| eval (
    name == "/etc/shells" ||
    name == "/etc/profile" ||
    name ~ "/etc/profile.d/" ||
    name == "/etc/bash.bashrc" ||
    name == "/etc/bashrc" ||
    name == "/etc/zsh/zprofile" ||
    name == "/etc/zsh/zshrc" ||
    name == "/etc/zsh/zlogin" ||
    name == "/etc/zsh/zlogout" ||
    name == "/etc/csh.cshrc" ||
    name == "/etc/csh.login" ||
    name == "/root/.bashrc" ||
    name == "/root/.bash_profile" ||
    name == "/root/.profile" ||
    name == "/root/.zshrc" ||
    name == "/root/.zprofile"
    ) || (
    strings_hasprefix(name, "/home/") && (
        strings_hassuffix(name, "/.bashrc") ||
        strings_hassuffix(name, "/.zshrc") ||
        strings_hassuffix(name, "/.bash_profile") ||
        strings_hassuffix(name, "/.zprofile") ||
        strings_hassuffix(name, "/.profile") ||
        strings_hassuffix(name, "/.bash_login") ||
        strings_hassuffix(name, "/.bash_logout") ||
        strings_hassuffix(name, "/.zlogin") ||
        strings_hassuffix(name, "/.zlogout")
    )
)