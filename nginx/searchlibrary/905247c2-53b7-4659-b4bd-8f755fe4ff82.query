| eval match(uri, "/checkupdate\.php") &&
       match(query, "lng=") && match(query, "ver=") && match(query, "beta=") &&
       match(query, "type=") && match(query, "rmode=") && match(query, "product=")
| table time remote_addr method uri query status user_agent