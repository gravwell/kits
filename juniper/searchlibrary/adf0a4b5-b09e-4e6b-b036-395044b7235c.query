tag=$JUNIPER_TAG ax Hostname Message ~ "LOGIN"
| grep -e Message -i "failed"
| $JUNIPER_LOGIN_HELPER
| lookup -v -r juniper_logins_exclusion_list Username excluded_users
| stats unique_count(Username) as UsernameCount unique_count(Hostname) as DestCount count by SrcIP Client_Mode
| table SrcIP Client_Mode UsernameCount DestCount count
