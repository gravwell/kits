tag=$JUNIPER_TAG ax Hostname Message ~ "LOGIN"
| grep -e Message -i "failed"
| $JUNIPER_LOGIN_HELPER
| lookup -v -r juniper_logins_exclusion_list Username excluded_users
| stats unique_count(Username) as UsernameCount unique_count(SrcIP) as SourceCount count by Hostname Client_Mode
| table Hostname Client_Mode UsernameCount SourceCount count
