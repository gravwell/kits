tag=$CANARY_AUDIT json action_type flock_id flock_name message timestamp user user_ip
| eval in(action_type, 
   	"flock_alter_config"
   	)
| eval message~"autocommission"
| regex -e message "(?P<operation>\w+)"
| eval operation~"Enabled"
| regex -e message "(?P<event_type>autocommission.*?)?\son"
| unique message
| printf -e context "at %v, %v (%v) %v %v via %v action to %v" timestamp user user_ip operation event_type action_type flock_id
| $CANARY_ALERT_META("Canary", "Flock Management", "Low", "Auto Commissioning Enabled")