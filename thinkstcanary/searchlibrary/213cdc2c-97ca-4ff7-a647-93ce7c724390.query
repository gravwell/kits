tag=$CANARY_AUDIT json action_type flock_id flock_name message timestamp user user_ip
| unique timestamp
| eval in(action_type,
    "flock_create",
    "flock_delete",
    "flock_move",
    "flock_rename"
    )
| stats count as total by flock_id flock_name user user_ip over 5m
| eval total > 1
| printf -e context "%v (%v) performed %v Flock actions on the %v Flock within 5 minutes" user user_ip total flock_name
| $CANARY_ALERT_META("Canary", "Flock Management", "Medium", "Multiple Flock Actions")
