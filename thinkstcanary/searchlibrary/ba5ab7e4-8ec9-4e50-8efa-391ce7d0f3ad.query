tag=$CANARY_AUDIT json timestamp action_type user user_ip message flock_id flock_name
| eval in(action_type, "user_login", "user_login_failed")
| unique timestamp user
| sort by timestamp
| eval result = (action_type=="user_login_failed") ? "failure" : ((action_type=="user_login") ? "success" : "")
| diff TIMESTAMP by result
| ip user_ip
| geoip user_ip.Location user_ip.City user_ip.Country user_ip.CountryName
| eval (Country!="US"||CountryName!="United States")
| stats -b total(diff) as login_attempt_duration count(result) as attempts by user user_ip result City Country CountryName flock_id flock_name over 5m
| printf -e context "%v attempted to login with a %v result from %v in %v, %v (%v) totalling %v attempts over %v" user result user_ip City Country CountryName attempts login_attempt_duration
| transaction -fsep " - " user user_ip
| regex -e transaction "fail.* - .*success"
| eval context = transaction
| $CANARY_ALERT_META("Canary", "User Management", "High", "Successful Login After Failure From Outside Country")
