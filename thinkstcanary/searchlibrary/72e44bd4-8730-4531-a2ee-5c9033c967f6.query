tag=$CANARY_AUDIT json action_type flock_id flock_name message timestamp user user_ip
| eval in(action_type, 
    "flock_alter_config"
    )
| regex -e message "(?P<operation>\w+)"
| regex -e message "(?P<operation>(Saved|Cleared|Disabled|Enabled))"
| regex -e message "(?P<event_type>notification emails)?\:"
| regex -e message "emails\:\s(?P<email_list>.*?)?\;"
| regex -e message "(added)\:\s(?P<emails_added>.*)"
| printf -e context "at %v, %v (%v) %v %v via %v action where %v added to email list: \"%v\" in %v Flock" timestamp user user_ip operation event_type action_type emails_added email_list flock_name
| $CANARY_ALERT_META("Canary", "Flock Management", "Low", "Email(s) Added to Device Notifications List")