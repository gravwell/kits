tag=$CANARY_AUDIT json action_type flock_id flock_name message timestamp user user_ip
| eval in(action_type, 
    "flock_alter_config"
    )
| regex -e message "(?P<operation>\w+)"
| lower operation
| regex -e message "(Enabled|Disabled)\s(?P<event_type>.*oper.*?)?\son"
| unique message
| printf -e context "at %v, %v (%v) %v %v via %v action in %v Flock" timestamp user user_ip operation event_type action_type flock_name
| $CANARY_ALERT_META("Canary", "Flock Management", "Low", "Operational Email Notifications Modified")