tag=$CANARY_AUDIT json timestamp action_type user user_ip message flock_id flock_name
| eval in(action_type,
    "user_login_failed"
    )
| regex -e message "(?P<operation>Login\s\w+)"
| lower operation
| regex -e message "using\s(?P<method>.*?)?\."
| ip user_ip
| geoip user_ip.Location user_ip.City user_ip.Country user_ip.CountryName
| eval (Country!="US"||CountryName!="United States")
| stats count by user user_ip operation method action_type City Country CountryName flock_id flock_name over 5m
| eval count > 5
| printf -e context "%v had %v %v attempts fail due to %v via %v action from %v in %v, %v (%v) within 5 minutes" user count operation method action_type user_ip City Country CountryName
| $CANARY_ALERT_META("Canary", "User Management", "High", "Brute Force Attempts from Outside Country")
