tag=$CANARY_AUDIT json timestamp action_type user user_ip message flock_id flock_name
| eval in(action_type,
    "user_login_failed"
    )
| regex -e message "(?P<operation>Login\s\w+)"
| lower operation
| regex -e message "using\s(?P<method>.*?)?\."
| stats count by user user_ip operation method action_type flock_id flock_name over 5m
| eval count > 5
| printf -e context "%v had %v %v attempts using %v via %v action from %v within 5 minutes" user count operation method action_type user_ip
| $CANARY_ALERT_META("Canary", "User Management", "Medium", "Brute Force Attempts")
