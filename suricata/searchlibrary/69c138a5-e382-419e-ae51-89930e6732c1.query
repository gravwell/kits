tag=$SURICATA json event_type=="fileinfo" fileinfo.filename as filename fileinfo.magic as magic src_ip dest_ip
| eval ((has(magic) && (magic ~ "PE32" || magic ~ "MS-DOS executable")) || (has(filename) && (strings_hassuffix(filename, ".exe") || strings_hassuffix(filename, ".dll") || strings_hassuffix(filename, ".msi"))))
| table TIMESTAMP src_ip dest_ip filename magic